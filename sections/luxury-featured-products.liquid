{% style %}
  .lux-tabs-container {
    margin-bottom: 40px;
    display: flex;
    justify-content: center;
    gap: 30px;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 15px;
  }
  
  .lux-tab-btn {
    font-family: var(--font-luxury-body);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0 0 14px 0;
    position: relative;
    transition: var(--transition-smooth);
  }
  
  .lux-tab-btn:hover {
    color: var(--color-primary);
  }
  
  .lux-tab-btn.active {
    color: var(--color-accent);
  }
  
  .lux-tab-btn.active::after {
    content: '';
    position: absolute;
    bottom: -16px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-accent);
  }
  
  .lux-tab-panel {
    display: none;
  }
  
  .lux-tab-panel.active {
    display: block;
    animation: luxFadeUp 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
  
  @keyframes luxFadeUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .lux-products-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 30px;
  }
  
  .lux-products-footer {
    text-align: center;
    margin-top: 50px;
  }
  
  @media (max-width: 991px) {
    .lux-products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }
  
  @media (max-width: 768px) {
    .lux-tabs-container {
      gap: 15px;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 10px;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }
    
    .lux-tab-btn {
      font-size: 11px;
      padding-bottom: 8px;
    }
    
    .lux-tab-btn.active::after {
      bottom: -11px;
    }
    
    .lux-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
  
  @media (max-width: 480px) {
    .lux-products-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<section class="luxury-section" data-section-id="{{ section.id }}">
  <div class="luxury-container">
    {%- if section.settings.subheading != blank -%}
      <span class="section-subtitle">{{ section.settings.subheading }}</span>
    {%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="luxury-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="luxury-p" style="text-align: center; max-width: 600px; margin-left: auto; margin-right: auto; margin-bottom: 40px;">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    <!-- Tab buttons -->
    <div class="lux-tabs-container">
      {%- assign tab_count = 0 -%}
      
      {%- if section.settings.collection_1 != blank -%}
        <button class="lux-tab-btn active" data-tab="tab-1">
          {{ section.settings.tab_title_1 | default: section.settings.collection_1.title }}
        </button>
        {%- assign tab_count = tab_count | plus: 1 -%}
      {%- endif -%}

      {%- if section.settings.collection_2 != blank -%}
        <button class="lux-tab-btn {% if tab_count == 0 %}active{% endif %}" data-tab="tab-2">
          {{ section.settings.tab_title_2 | default: section.settings.collection_2.title }}
        </button>
        {%- assign tab_count = tab_count | plus: 1 -%}
      {%- endif -%}

      {%- if section.settings.collection_3 != blank -%}
        <button class="lux-tab-btn {% if tab_count == 0 %}active{% endif %}" data-tab="tab-3">
          {{ section.settings.tab_title_3 | default: section.settings.collection_3.title }}
        </button>
        {%- assign tab_count = tab_count | plus: 1 -%}
      {%- endif -%}

      {%- if section.settings.collection_4 != blank -%}
        <button class="lux-tab-btn {% if tab_count == 0 %}active{% endif %}" data-tab="tab-4">
          {{ section.settings.tab_title_4 | default: section.settings.collection_4.title }}
        </button>
      {%- endif -%}
    </div>

    <!-- Tab Panels -->
    {%- assign panel_count = 0 -%}
    
    {%- if section.settings.collection_1 != blank -%}
      <div class="lux-tab-panel active" id="tab-1">
        <div class="lux-products-grid">
          {%- for product in section.settings.collection_1.products limit: section.settings.products_limit -%}
            {%- render 'luxury-product-card', product: product -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <div class="lux-products-footer">
            <a href="{{ section.settings.collection_1.url }}" class="luxury-btn luxury-btn-secondary">
              View All {{ section.settings.collection_1.title }}
            </a>
          </div>
        {%- endif -%}
      </div>
      {%- assign panel_count = panel_count | plus: 1 -%}
    {%- endif -%}

    {%- if section.settings.collection_2 != blank -%}
      <div class="lux-tab-panel {% if panel_count == 0 %}active{% endif %}" id="tab-2">
        <div class="lux-products-grid">
          {%- for product in section.settings.collection_2.products limit: section.settings.products_limit -%}
            {%- render 'luxury-product-card', product: product -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <div class="lux-products-footer">
            <a href="{{ section.settings.collection_2.url }}" class="luxury-btn luxury-btn-secondary">
              View All {{ section.settings.collection_2.title }}
            </a>
          </div>
        {%- endif -%}
      </div>
      {%- assign panel_count = panel_count | plus: 1 -%}
    {%- endif -%}

    {%- if section.settings.collection_3 != blank -%}
      <div class="lux-tab-panel {% if panel_count == 0 %}active{% endif %}" id="tab-3">
        <div class="lux-products-grid">
          {%- for product in section.settings.collection_3.products limit: section.settings.products_limit -%}
            {%- render 'luxury-product-card', product: product -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <div class="lux-products-footer">
            <a href="{{ section.settings.collection_3.url }}" class="luxury-btn luxury-btn-secondary">
              View All {{ section.settings.collection_3.title }}
            </a>
          </div>
        {%- endif -%}
      </div>
      {%- assign panel_count = panel_count | plus: 1 -%}
    {%- endif -%}

    {%- if section.settings.collection_4 != blank -%}
      <div class="lux-tab-panel {% if panel_count == 0 %}active{% endif %}" id="tab-4">
        <div class="lux-products-grid">
          {%- for product in section.settings.collection_4.products limit: section.settings.products_limit -%}
            {%- render 'luxury-product-card', product: product -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <div class="lux-products-footer">
            <a href="{{ section.settings.collection_4.url }}" class="luxury-btn luxury-btn-secondary">
              View All {{ section.settings.collection_4.title }}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('[data-section-id="{{ section.id }}"] .lux-tab-btn');
    const panels = document.querySelectorAll('[data-section-id="{{ section.id }}"] .lux-tab-panel');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Remove active class from all tabs & panels
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));
        
        // Add active class to clicked tab and its panel
        tab.classList.add('active');
        const targetId = tab.dataset.tab;
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  });
</script>

{% schema %}
