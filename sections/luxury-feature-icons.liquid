{% style %}
  .lux-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 30px;
    margin-top: 30px;
  }
  
  .lux-feature-item {
    background-color: var(--color-bg-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-card);
    padding: 36px 24px;
    text-align: center;
    transition: var(--transition-smooth);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .lux-feature-item:hover {
    transform: translateY(-5px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-subtle);
  }
  
  .lux-feature-item__icon-container {
    color: var(--color-accent);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .lux-feature-item__icon-container svg {
    width: 38px;
    height: 38px;
    stroke-width: 1.25;
  }
  
  .lux-feature-item__title {
    font-family: var(--font-luxury-body);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin: 0 0 10px 0;
  }
  
  .lux-feature-item__desc {
    font-family: var(--font-luxury-body);
    font-size: 12px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-secondary);
    margin: 0;
  }
  
  @media (max-width: 768px) {
    .lux-features {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
  @media (max-width: 480px) {
    .lux-features {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<section class="luxury-section">
  <div class="luxury-container">
    {%- if section.settings.subheading != blank -%}
      <span class="section-subtitle">{{ section.settings.subheading }}</span>
    {%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="luxury-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="lux-features">
      {%- for block in section.blocks -%}
        <div class="lux-feature-item" {{ block.shopify_attributes }}>
          
          <div class="lux-feature-item__icon-container">
            {%- case block.settings.icon_type -%}
              {%- when 'shipping' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              {%- when 'payment' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              {%- when 'returns' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="23 4 23 10 17 10"></polyline>
                  <polyline points="1 20 1 14 7 14"></polyline>
                  <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
              {%- when 'quality' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="7"></circle>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
              {%- when 'custom' -%}
                {{ block.settings.custom_icon_svg }}
            {%- endcase -%}
          </div>

          <h3 class="lux-feature-item__title">{{ block.settings.title }}</h3>
          <p class="lux-feature-item__desc">{{ block.settings.description }}</p>

        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature Icons",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Why Choose Us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Commitment to Premium Quality"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Block",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Symbol",
          "options": [
            {
              "value": "shipping",
              "label": "Free Shipping"
            },
            {
              "value": "payment",
              "label": "Secure Payment"
            },
            {
              "value": "returns",
              "label": "Easy Returns"
            },
            {
              "value": "quality",
              "label": "Premium Quality"
            },
            {
              "value": "custom",
              "label": "Custom SVG Code"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "html",
          "id": "custom_icon_svg",
          "label": "Custom SVG HTML",
          "info": "Used only if Icon Symbol is set to 'Custom SVG Code'"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "Free Worldwide Shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Feature Description",
          "default": "Receive complimentary shipping directly to your doorstep on orders value exceeding $150."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Icons",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon_type": "shipping",
            "title": "Free Shipping",
            "description": "On all orders over $150 worldwide."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "payment",
            "title": "Secure Payment",
            "description": "Your financial transactions are fully encrypted."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "returns",
            "title": "Easy Returns",
            "description": "Hassle-free returns within 30 days of purchase."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon_type": "quality",
            "title": "Premium Quality",
            "description": "Indulge in carefully sourced organic perfume oils."
          }
        }
      ]
    }
  ]
}
{% endschema %}
