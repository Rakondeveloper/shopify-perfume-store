{%- if section.settings.enable_announcement -%}
  {% style %}
    .lux-announcement {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      font-family: var(--font-luxury-body);
      font-size: 11px;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      font-weight: 500;
      text-align: center;
      position: relative;
      z-index: 10;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .lux-announcement__link {
      color: inherit;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: var(--transition-smooth);
    }
    .lux-announcement__link:hover {
      opacity: 0.8;
    }
    .lux-announcement__icon svg {
      width: 14px;
      height: 14px;
      vertical-align: middle;
    }
  {% endstyle %}

  <div class="lux-announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="lux-announcement__link">
    {%- else -%}
      <div class="lux-announcement__link">
    {%- endif -%}

      {%- if section.settings.icon_svg != blank -%}
        <span class="lux-announcement__icon">{{ section.settings.icon_svg }}</span>
      {%- endif -%}

      <span>{{ section.settings.text }}</span>

    {%- if section.settings.link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Luxury Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Free worldwide shipping on orders over $150"
    },
    {
      "type": "html",
      "id": "icon_svg",
      "label": "Icon (SVG Code)",
      "info": "Paste custom SVG icon code here"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Luxury Announcement Bar"
    }
  ]
}
{% endschema %}
