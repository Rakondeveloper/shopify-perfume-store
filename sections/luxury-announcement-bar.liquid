{%- if section.settings.enable_announcement -%}
  {% style %}
    .lux-announcement {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 40px;
      padding-right: 40px;
      font-size: {{ section.settings.font_size }}px;
      font-weight: {{ section.settings.font_weight }};
      letter-spacing: 0.05em;
      position: relative;
      z-index: 100;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      font-family: var(--font-{{ section.settings.font_family_base }}--family), sans-serif;
      font-style: var(--font-{{ section.settings.font_family_base }}--style), normal;
    }

    .lux-announcement__left {
      display: flex;
      gap: 24px;
      align-items: center;
      justify-content: flex-start;
    }

    .lux-localization-form {
      display: flex;
      gap: 24px;
      align-items: center;
    }

    .lux-dropdown {
      position: relative;
      display: inline-block;
    }

    .lux-dropdown__trigger {
      background: transparent;
      border: none;
      color: inherit;
      font-family: inherit;
      font-size: inherit;
      font-weight: inherit;
      letter-spacing: inherit;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 0;
      line-height: 1;
      text-transform: inherit;
    }

    .lux-dropdown__trigger:hover {
      opacity: 0.8;
    }

    .lux-chevron-down {
      width: 8px;
      height: 5px;
      margin-left: 1px;
      display: inline-block;
      vertical-align: middle;
      transition: transform 0.2s ease;
      color: inherit;
    }

    .lux-dropdown__trigger[aria-expanded="true"] .lux-chevron-down {
      transform: rotate(180deg);
    }

    .lux-dropdown__menu {
      position: absolute;
      top: 100%;
      left: 0;
      background-color: #161616;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      padding: 8px 0;
      margin-top: 8px;
      min-width: 140px;
      z-index: 1000;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }

    .lux-dropdown__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
    }

    .lux-dropdown__item {
      margin: 0;
    }

    .lux-dropdown__button {
      width: 100%;
      text-align: left;
      background: transparent;
      border: none;
      color: rgba(255, 255, 255, 0.8);
      padding: 8px 16px;
      font-size: 11px;
      cursor: pointer;
      white-space: nowrap;
      transition: background-color 0.2s ease, color 0.2s ease;
      font-family: inherit;
      letter-spacing: 0.05em;
    }

    .lux-dropdown__button:hover {
      background-color: rgba(255, 255, 255, 0.08);
      color: #ffffff;
    }

    .lux-dropdown__button.is-active {
      font-weight: 600;
      color: #c5a880; /* Luxury gold accent */
      background-color: rgba(255, 255, 255, 0.04);
    }

    .lux-announcement__center {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
    }

    .lux-announcement__right {
      display: flex;
      gap: 24px;
      align-items: center;
      justify-content: flex-end;
    }

    .lux-announcement__link {
      color: inherit;
      text-decoration: none;
      transition: opacity 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .lux-announcement__link:hover {
      opacity: 0.8;
    }

    @media (max-width: 991px) {
      .lux-announcement {
        grid-template-columns: 1fr;
        grid-gap: 12px;
        text-align: center;
        padding-left: 15px;
        padding-right: 15px;
      }
      .lux-announcement__left,
      .lux-announcement__right {
        justify-content: center;
      }
      .lux-dropdown__menu {
        left: 50%;
        transform: translateX(-50%);
      }
    }
  {% endstyle %}

  <div class="lux-announcement">
    
    <!-- Left: Selectors (Currency and Language dropdowns) -->
    <div class="lux-announcement__left">
      {%- form 'localization', id: 'AnnouncementBarLocalizationForm', class: 'lux-localization-form' -%}
        
        <!-- Currency Dropdown -->
        {%- if section.settings.show_currency_selector -%}
          <div class="lux-dropdown" data-dropdown>
            <button type="button" class="lux-dropdown__trigger" data-dropdown-trigger aria-expanded="false" aria-haspopup="true">
              {{ localization.country.currency.iso_code | default: 'USD' }}
              <svg class="lux-chevron-down" width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="lux-dropdown__menu" data-dropdown-menu hidden>
              <ul class="lux-dropdown__list">
                {%- if localization.available_countries.size > 1 -%}
                  {%- for country in localization.available_countries -%}
                    <li class="lux-dropdown__item">
                      <button type="button" class="lux-dropdown__button {% if country.iso_code == localization.country.iso_code %}is-active{% endif %}" data-value="{{ country.iso_code }}" data-type="country">
                        {{ country.currency.iso_code }} ({{ country.currency.symbol }}) - {{ country.name }}
                      </button>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <!-- Fallback interactive mock options for styling and demo presentation -->
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button is-active" data-value="{{ localization.country.iso_code }}" data-type="country">
                      {{ localization.country.currency.iso_code }} ({{ localization.country.currency.symbol }})
                    </button>
                  </li>
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button" data-value="EU" data-type="mock">
                      EUR (€)
                    </button>
                  </li>
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button" data-value="GB" data-type="mock">
                      GBP (£)
                    </button>
                  </li>
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button" data-value="QA" data-type="mock">
                      QAR (QR)
                    </button>
                  </li>
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button" data-value="AE" data-type="mock">
                      AED (Dhs)
                    </button>
                  </li>
                {%- endif -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        <!-- Language Dropdown -->
        {%- if section.settings.show_language_selector -%}
          <div class="lux-dropdown" data-dropdown>
            <button type="button" class="lux-dropdown__trigger" data-dropdown-trigger aria-expanded="false" aria-haspopup="true">
              {{ localization.language.endonym_name | capitalize | default: 'English' }}
              <svg class="lux-chevron-down" width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="lux-dropdown__menu" data-dropdown-menu hidden>
              <ul class="lux-dropdown__list">
                {%- if localization.available_languages.size > 1 -%}
                  {%- for language in localization.available_languages -%}
                    <li class="lux-dropdown__item">
                      <button type="button" class="lux-dropdown__button {% if language.iso_code == localization.language.iso_code %}is-active{% endif %}" data-value="{{ language.iso_code }}" data-type="language">
                        {{ language.endonym_name | capitalize }}
                      </button>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  <!-- Fallback interactive mock options for styling and demo presentation -->
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button is-active" data-value="{{ localization.language.iso_code }}" data-type="language">
                      {{ localization.language.endonym_name | capitalize }}
                    </button>
                  </li>
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button" data-value="ar" data-type="mock">
                      العربية
                    </button>
                  </li>
                  <li class="lux-dropdown__item">
                    <button type="button" class="lux-dropdown__button" data-value="fr" data-type="mock">
                      Français
                    </button>
                  </li>
                {%- endif -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" data-country-input>
        <input type="hidden" name="language_code" value="{{ localization.language.iso_code }}" data-language-input>
      {%- endform -%}
    </div>

    <!-- Center: Emojis + Main Text -->
    <div class="lux-announcement__center">
      {%- if section.settings.left_emoji != blank -%}
        <span>{{ section.settings.left_emoji }}</span>
      {%- endif -%}

      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="lux-announcement__link">
          {{ section.settings.text }}
        </a>
      {%- else -%}
        <span>{{ section.settings.text }}</span>
      {%- endif -%}

      {%- if section.settings.right_emoji != blank -%}
        <span>{{ section.settings.right_emoji }}</span>
      {%- endif -%}
    </div>

    <!-- Right: Utility Links -->
    <div class="lux-announcement__right">
      {%- if section.settings.help_text != blank -%}
        <a href="{{ section.settings.help_link | default: '#' }}" class="lux-announcement__link">
          {{ section.settings.help_text }}
        </a>
      {%- endif -%}

      {%- if section.settings.connect_text != blank -%}
        <a href="{{ section.settings.connect_link | default: '#' }}" class="lux-announcement__link">
          {{ section.settings.connect_text }}
        </a>
      {%- endif -%}
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const dropdowns = document.querySelectorAll('.lux-dropdown');
      
      dropdowns.forEach(dropdown => {
        const trigger = dropdown.querySelector('[data-dropdown-trigger]');
        const menu = dropdown.querySelector('[data-dropdown-menu]');
        
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = trigger.getAttribute('aria-expanded') === 'true';
          
          // Close other active dropdowns
          dropdowns.forEach(d => {
            if (d !== dropdown) {
              d.querySelector('[data-dropdown-trigger]').setAttribute('aria-expanded', 'false');
              d.querySelector('[data-dropdown-menu]').setAttribute('hidden', '');
            }
          });
          
          if (isOpen) {
            trigger.setAttribute('aria-expanded', 'false');
            menu.setAttribute('hidden', '');
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            menu.removeAttribute('hidden');
          }
        });
      });

      // Handle dropdown option selections
      document.querySelectorAll('.lux-dropdown__button').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const value = btn.getAttribute('data-value');
          const type = btn.getAttribute('data-type');
          const form = btn.closest('form');
          const dropdown = btn.closest('.lux-dropdown');
          const trigger = dropdown.querySelector('[data-dropdown-trigger]');
          const menu = dropdown.querySelector('[data-dropdown-menu]');
          
          trigger.setAttribute('aria-expanded', 'false');
          menu.setAttribute('hidden', '');

          if (type === 'mock') {
            // Update active visually for mock demo options
            const textNode = trigger.childNodes[0];
            textNode.textContent = btn.textContent.trim().split(' ')[0] + ' ';
            dropdown.querySelectorAll('.lux-dropdown__button').forEach(b => b.classList.remove('is-active'));
            btn.classList.add('is-active');
          } else {
            if (type === 'country') {
              form.querySelector('[data-country-input]').value = value;
            } else if (type === 'language') {
              form.querySelector('[data-language-input]').value = value;
            }
            form.submit();
          }
        });
      });

      // Close dropdowns on outside clicks
      document.addEventListener('click', () => {
        dropdowns.forEach(dropdown => {
          dropdown.querySelector('[data-dropdown-trigger]').setAttribute('aria-expanded', 'false');
          dropdown.querySelector('[data-dropdown-menu]').setAttribute('hidden', '');
        });
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Luxury Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Left: Selectors"
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show Currency Selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show Language Selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Center: Announcement"
    },
    {
      "type": "text",
      "id": "left_emoji",
      "label": "Left Emoji/Icon",
      "default": "🔥"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Only 11 days left until NEW YEAR"
    },
    {
      "type": "text",
      "id": "right_emoji",
      "label": "Right Emoji/Icon",
      "default": "🔥"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link"
    },
    {
      "type": "header",
      "content": "Right: Utility Links"
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help & Info Text",
      "default": "Help & Information"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help & Info Link"
    },
    {
      "type": "text",
      "id": "connect_text",
      "label": "Connect Text",
      "default": "Connect with us"
    },
    {
      "type": "url",
      "id": "connect_link",
      "label": "Connect Link"
    },
    {
      "type": "header",
      "content": "Styles & Typography"
    },
    {
      "type": "select",
      "id": "font_family_base",
      "label": "Font Family Source",
      "info": "Choose which global typography font family settings to link to.",
      "options": [
        {
          "value": "body",
          "label": "Body Font"
        },
        {
          "value": "subheading",
          "label": "Subheading Font"
        },
        {
          "value": "heading",
          "label": "Heading Font"
        },
        {
          "value": "accent",
          "label": "Accent Font"
        }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight Override",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 11
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Luxury Announcement Bar"
    }
  ]
}
{% endschema %}
