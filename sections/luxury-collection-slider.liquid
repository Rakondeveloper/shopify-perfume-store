{%- if section.settings.collection != blank -%}
  <!-- Load Swiper CSS non-blocking -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'">
  <!-- Load Swiper JS deferred -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>

  {% style %}
    .lux-slider-wrapper {
      position: relative;
      margin-top: 40px;
    }
    
    .lux-slider-container {
      overflow: hidden;
      padding-bottom: 20px;
    }
    
    /* Navigation Arrows styling */
    .lux-slider-controls {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-bottom: 20px;
    }
    
    .lux-slider-arrow {
      background-color: var(--color-bg-light);
      border: 1px solid var(--color-border);
      color: var(--color-primary);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: var(--shadow-subtle);
      transition: var(--transition-smooth);
    }
    
    .lux-slider-arrow:hover {
      background-color: var(--color-primary);
      color: var(--color-white);
      border-color: var(--color-primary);
    }
    
    .lux-slider-arrow svg {
      width: 18px;
      height: 18px;
    }
  {% endstyle %}

  <section class="luxury-section">
    <div class="luxury-container">
      
      <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 10px;">
        <div style="text-align: left;">
          {%- if section.settings.subheading != blank -%}
            <span class="section-subtitle" style="text-align: left;">{{ section.settings.subheading }}</span>
          {%- endif -%}
          
          {%- if section.settings.heading != blank -%}
            <h2 class="luxury-h2" style="text-align: left; margin-bottom: 0;">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        
        <!-- Slider Navigation Arrows -->
        <div class="lux-slider-controls">
          <button class="lux-slider-arrow swiper-button-prev-{{ section.id }}" aria-label="Previous products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
          <button class="lux-slider-arrow swiper-button-next-{{ section.id }}" aria-label="Next products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <div class="lux-slider-wrapper">
        <div class="swiper lux-slider-container lux-slider-{{ section.id }}">
          <div class="swiper-wrapper">
            {%- for product in section.settings.collection.products limit: section.settings.products_limit -%}
              <div class="swiper-slide">
                {%- render 'luxury-product-card', product: product -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      function initSlider() {
        if (typeof Swiper !== 'undefined') {
          new Swiper('.lux-slider-{{ section.id }}', {
            slidesPerView: 1,
            spaceBetween: 15,
            loop: false,
            navigation: {
              nextEl: '.swiper-button-next-{{ section.id }}',
              prevEl: '.swiper-button-prev-{{ section.id }}',
            },
            breakpoints: {
              480: {
                slidesPerView: 1,
                spaceBetween: 15
              },
              768: {
                slidesPerView: 2,
                spaceBetween: 20
              },
              992: {
                slidesPerView: 3,
                spaceBetween: 25
              },
              1200: {
                slidesPerView: 4,
                spaceBetween: 30
              }
            }
          });
        } else {
          // Retry if script tag is still loading
          setTimeout(initSlider, 50);
        }
      }
      initSlider();
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Collection Slider",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Shop Best Sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A World of Scents, Curated for You"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Products limit",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Collection Slider"
    }
  ]
}
{% endschema %}
