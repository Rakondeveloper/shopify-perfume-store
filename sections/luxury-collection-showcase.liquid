{% style %}
  .lux-showcase {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }
  
  .lux-showcase-card {
    position: relative;
    border-radius: var(--border-radius-card);
    overflow: hidden;
    height: 480px;
    display: flex;
    align-items: flex-end;
    background-color: var(--color-bg-gray);
    box-shadow: var(--shadow-subtle);
    transition: var(--transition-smooth);
  }
  
  .lux-showcase-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-medium);
  }
  
  .lux-showcase-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  
  .lux-showcase-card__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 60%, rgba(0,0,0,0.0) 100%);
    z-index: 2;
    transition: var(--transition-smooth);
  }
  
  .lux-showcase-card:hover .lux-showcase-card__overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 60%, rgba(0,0,0,0.0) 100%);
  }
  
  .lux-showcase-card__content {
    position: relative;
    z-index: 3;
    padding: 40px 30px;
    color: var(--color-white);
    width: 100%;
    box-sizing: border-box;
  }
  
  .lux-showcase-card__title {
    font-family: var(--font-luxury-heading);
    font-size: 28px;
    font-weight: 500;
    margin: 0 0 10px 0;
    color: var(--color-white);
    letter-spacing: 0.02em;
  }
  
  .lux-showcase-card__description {
    font-family: var(--font-luxury-body);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.5;
    margin: 0 0 24px 0;
    color: rgba(255, 255, 255, 0.85);
  }
  
  .lux-showcase-card__btn {
    padding: 10px 24px;
    font-size: 11px;
  }
  
  @media (max-width: 768px) {
    .lux-showcase {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .lux-showcase-card {
      height: 400px;
    }
  }
{% endstyle %}

<section class="luxury-section">
  <div class="luxury-container">
    {%- if section.settings.subheading != blank -%}
      <span class="section-subtitle">{{ section.settings.subheading }}</span>
    {%- endif -%}
    
    {%- if section.settings.heading != blank -%}
      <h2 class="luxury-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="lux-showcase">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_image = block.settings.image
          assign block_collection = block.settings.collection
          assign block_title = block.settings.title | default: block_collection.title
          assign block_description = block.settings.description | default: block_collection.description | truncate: 120
          assign btn_label = block.settings.btn_label | default: "Discover"
          assign btn_link = block.settings.btn_link | default: block_collection.url
        -%}
        <div class="lux-showcase-card image-zoom-container" {{ block.shopify_attributes }}>
          {%- if block_image != blank -%}
            <img 
              src="{{ block_image | image_url: width: 800 }}" 
              alt="{{ block_title | escape }}"
              class="lux-showcase-card__image"
              loading="lazy"
              width="400"
              height="480"
            >
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg lux-showcase-card__image' }}
          {%- endif -%}
          
          <div class="lux-showcase-card__overlay"></div>
          
          <div class="lux-showcase-card__content">
            <h3 class="lux-showcase-card__title">{{ block_title }}</h3>
            {%- if block_description != blank -%}
              <p class="lux-showcase-card__description">{{ block_description }}</p>
            {%- endif -%}
            {%- if btn_link != blank -%}
              <a href="{{ btn_link }}" class="luxury-btn luxury-btn-white lux-showcase-card__btn">
                {{ btn_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Showcase",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitle",
      "default": "Natural Fragrances"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Curated Collection of Timeless Fragrances"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides the collection default image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Custom Description",
          "info": "Leave blank to use collection description"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button Label",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link",
          "info": "Leave blank to link directly to the collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Showcase",
      "blocks": [
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        },
        {
          "type": "collection_card"
        }
      ]
    }
  ]
}
{% endschema %}
