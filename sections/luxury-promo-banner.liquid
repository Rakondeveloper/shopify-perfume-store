{% style %}
  .lux-promo {
    position: relative;
    background-color: var(--color-bg-dark);
    border-radius: var(--border-radius-section);
    overflow: hidden;
    padding: 100px 24px;
    text-align: center;
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 460px;
  }
  
  .lux-promo__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    opacity: 0.35;
  }
  
  /* Large decorative outline logo text behind content */
  .lux-promo__bg-text {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: calc(4rem + 10vw);
    font-family: var(--font-luxury-heading);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.05);
    white-space: nowrap;
    z-index: 2;
    pointer-events: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .lux-promo__content {
    position: relative;
    z-index: 3;
    max-width: 650px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .lux-promo__heading {
    font-family: var(--font-luxury-heading);
    font-size: calc(1.8rem + 2vw);
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 16px;
    color: var(--color-white);
    letter-spacing: 0.02em;
  }
  
  .lux-promo__desc {
    font-family: var(--font-luxury-body);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 30px;
    color: rgba(255,255,255,0.85);
  }
  
  /* Countdown Timer */
  .lux-countdown {
    display: flex;
    gap: 20px;
    margin-bottom: 40px;
  }
  
  .lux-countdown__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: var(--border-radius-card);
    min-width: 80px;
    padding: 16px 10px;
  }
  
  .lux-countdown__num {
    font-family: var(--font-luxury-heading);
    font-size: 32px;
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: 6px;
  }
  
  .lux-countdown__label {
    font-family: var(--font-luxury-body);
    font-size: 9px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.6);
  }
  
  .lux-promo__btn {
    padding: 14px 40px;
    font-size: 12px;
  }
  
  @media (max-width: 768px) {
    .lux-promo {
      padding: 60px 16px;
      min-height: 400px;
    }

    .lux-promo__content {
      align-items: center;
      text-align: center;
    }

    .lux-promo__heading {
      text-align: center;
    }

    .lux-promo__desc {
      text-align: center;
    }

    .lux-promo__btn {
      width: 100%;
      justify-content: center;
    }
    
    .lux-countdown {
      gap: 10px;
    }
    
    .lux-countdown__item {
      min-width: 60px;
      padding: 10px 6px;
    }
    
    .lux-countdown__num {
      font-size: 22px;
    }
    
    .lux-countdown__label {
      font-size: 8px;
    }
  }

  @media (max-width: 480px) {
    .lux-promo__heading {
      font-size: calc(1.3rem + 1vw);
    }

    .lux-promo__desc {
      font-size: 13px;
    }

    /* Hide large decorative text on very small screens */
    .lux-promo__bg-text {
      display: none;
    }

    .lux-countdown__item {
      min-width: 52px;
      padding: 8px 4px;
    }

    .lux-countdown__num {
      font-size: 18px;
    }
  }
{% endstyle %}

<section class="luxury-section">
  <div class="luxury-container">
    <div class="lux-promo">
      
      <!-- Desktop & Mobile background images -->
      {%- if section.settings.image_desktop != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 768 }}">
          {%- endif -%}
          <img 
            src="{{ section.settings.image_desktop | image_url: width: 1500 }}" 
            alt="{{ section.settings.heading | escape }}"
            class="lux-promo__bg"
            loading="lazy"
            width="1200"
            height="460"
          >
        </picture>
      {%- endif -%}

      <!-- Large outline background text -->
      {%- if section.settings.bg_text != blank -%}
        <div class="lux-promo__bg-text">{{ section.settings.bg_text }}</div>
      {%- endif -%}

      <div class="lux-promo__content" data-countdown-banner="{{ section.id }}">
        {%- if section.settings.heading != blank -%}
          <h2 class="lux-promo__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="lux-promo__desc">{{ section.settings.description }}</p>
        {%- endif -%}

        <!-- Countdown Clock -->
        {%- if section.settings.enable_countdown and section.settings.countdown_date != blank -%}
          <div class="lux-countdown" data-end-date="{{ section.settings.countdown_date }}">
            <div class="lux-countdown__item">
              <span class="lux-countdown__num" data-days>00</span>
              <span class="lux-countdown__label">Days</span>
            </div>
            <div class="lux-countdown__item">
              <span class="lux-countdown__num" data-hours>00</span>
              <span class="lux-countdown__label">Hrs</span>
            </div>
            <div class="lux-countdown__item">
              <span class="lux-countdown__num" data-minutes>00</span>
              <span class="lux-countdown__label">Mins</span>
            </div>
            <div class="lux-countdown__item">
              <span class="lux-countdown__num" data-seconds>00</span>
              <span class="lux-countdown__label">Secs</span>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.btn_label != blank and section.settings.btn_link != blank -%}
          <a href="{{ section.settings.btn_link }}" class="luxury-btn luxury-btn-white lux-promo__btn">
            {{ section.settings.btn_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{%- if section.settings.enable_countdown and section.settings.countdown_date != blank -%}
  <script>
    (function initCountdown_{{ section.id | replace: "-", "_" }}() {
      const banner = document.querySelector('[data-countdown-banner="{{ section.id }}"]');
      if (!banner) return;
      
      const countdownEl = banner.querySelector('.lux-countdown');
      if (!countdownEl) return;
      
      const endDateString = countdownEl.dataset.endDate;
      const targetTime = new Date(endDateString).getTime();
      
      if (isNaN(targetTime)) {
        console.warn("Invalid countdown date format: " + endDateString);
        return;
      }
      
      const daysEl = countdownEl.querySelector('[data-days]');
      const hoursEl = countdownEl.querySelector('[data-hours]');
      const minutesEl = countdownEl.querySelector('[data-minutes]');
      const secondsEl = countdownEl.querySelector('[data-seconds]');
      
      function updateTimer() {
        const now = new Date().getTime();
        const difference = targetTime - now;
        
        if (difference <= 0) {
          countdownEl.style.display = 'none';
          clearInterval(timerInterval);
          return;
        }
        
        const days = Math.floor(difference / (1000 * 60 * 60 * 24));
        const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((difference % (1000 * 60)) / 1000);
        
        if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
      }
      
      updateTimer();
      const timerInterval = setInterval(updateTimer, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Luxury Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "bg_text",
      "label": "Outline Background Text",
      "default": "Fragranço"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image (Optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Up to 40% Off — Limited Time"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Celebrate the season of elegance. Claim our exclusive perfume discounts on select items before the timer runs out."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop the Sale"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Countdown Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_countdown",
      "label": "Enable Countdown Timer",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown End Date",
      "default": "2026-12-31 23:59:59",
      "info": "Format: YYYY-MM-DD HH:MM:SS (e.g. 2026-12-31 18:00:00)"
    }
  ],
  "presets": [
    {
      "name": "Luxury Promo Banner"
    }
  ]
}
{% endschema %}
