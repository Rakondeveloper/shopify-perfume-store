              </div>
              <!-- PayPal -->
              <div class="fragranco-payment-badge" title="PayPal">
                <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="3" fill="#003087"/><path d="M12.5 17h-2.2l1.8-11.2h4.5c2.3 0 3.7 1.1 3.3 3.3-.4 2.5-2.2 3.9-4.5 3.9h-1.6L12.5 17z" fill="#0079C1"/><path d="M14.5 14h-2.1l1.3-8.2h4.5c1.8 0 3.1.9 2.8 2.8-.4 2.5-2.2 3.9-4.5 3.9h-2L14.5 14z" fill="#00457C"/><path d="M16 19h-2.2l1.3-8.2h4.5c2.3 0 3.7 1.1 3.3 3.3-.4 2.5-2.2 3.9-4.5 3.9h-1.6L16 19z" fill="#0079C1"/></svg>
              </div>
              <!-- Amazon Pay -->
              <div class="fragranco-payment-badge" title="Amazon Pay">
                <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="3" fill="#F8991D"/><path d="M12.5 14.2c-2.1.2-3.5-.8-3.5-2.3 0-1.8 1.6-2.5 3.5-2.5h1.2v.8c0 1.2-.5 2.1-1.2 2.6v1.4zm1.2-5.8h-1.5c-2.8 0-4.8 1.2-4.8 3.6 0 2.2 1.8 3.5 4.1 3.5 1.6 0 2.8-.7 3.4-1.7v1.4h1.7V8.4h-2.9v0zm9.4 6.7h1.7V11c0-1.8-1.1-2.6-2.7-2.6-1.5 0-2.6.7-3.1 1.7l1.3.8c.4-.6 1-1 1.8-1 .9 0 1.4.4 1.4 1.2v.5c-.6 0-1.4 0-2.3.1-2.1.2-3.4 1.1-3.4 2.6 0 1.5 1.2 2.4 2.7 2.4 1.2 0 2.2-.5 2.7-1.3v1.3zm-1.7-1.4c-.4.5-1.1.8-1.8.8-.8 0-1.3-.4-1.3-1.1 0-.8.7-1.2 1.8-1.3.6 0 1.1 0 1.3.1v1.5z" fill="#111"/></svg>
              </div>
            {% endif %}
          </div>
        {% endif %}

        <!-- Social Media Links -->
        {% if section.settings.show_social_icons %}
          <div class="fragranco-socials-row">
            <!-- Facebook -->
            {% if settings.social_facebook_link != blank or true %}
              <a href="{{ settings.social_facebook_link | default: '#' }}" class="fragranco-social-link" aria-label="Facebook" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            {% endif %}

            <!-- X / Twitter -->
            {% if settings.social_x_link != blank or settings.social_twitter_link != blank or true %}
              <a href="{{ settings.social_x_link | default: settings.social_twitter_link | default: '#' }}" class="fragranco-social-link" aria-label="X (Twitter)" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
              </a>
            {% endif %}

            <!-- Instagram -->
            {% if settings.social_instagram_link != blank or true %}
              <a href="{{ settings.social_instagram_link | default: '#' }}" class="fragranco-social-link" aria-label="Instagram" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            {% endif %}

            <!-- Pinterest -->
            {% if settings.social_pinterest_link != blank or true %}
              <a href="{{ settings.social_pinterest_link | default: '#' }}" class="fragranco-social-link" aria-label="Pinterest" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.746-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.627 0 11.999-5.373 11.999-12S18.644 0 12.017 0z"></path></svg>
              </a>
            {% endif %}
          </div>
        {% endif %}

      </div>

    </div>

    <!-- Oversized Brand Wordmark -->
    <div class="fragranco-wordmark-container">
      <div class="fragranco-wordmark-flex">
        {% if section.settings.brand_logo != blank %}
          <img src="{{ section.settings.brand_logo | image_url: width: 1200 }}" alt="{{ shop.name }}" class="fragranco-wordmark-logo-img" loading="lazy">
        {% else %}
          <h2 class="fragranco-wordmark-title">
            <span>{{ section.settings.brand_text | default: "Fragranco" }}</span>
            {% if section.settings.show_starburst %}
              <!-- Decorative 7-Ray Starburst Vector Icon -->
              <svg class="fragranco-starburst-icon" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Center point ray bursts radiating top-right -->
                <path d="M20 80 L75 25 M75 25 L50 20 M75 25 L80 45" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
                <line x1="20" y1="80" x2="20" y2="40" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
                <line x1="20" y1="80" x2="55" y2="50" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
                <line x1="20" y1="80" x2="60" y2="80" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
                <line x1="20" y1="80" x2="80" y2="10" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
                <line x1="20" y1="80" x2="40" y2="15" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
                <line x1="20" y1="80" x2="90" y2="45" stroke="currentColor" stroke-width="7" stroke-linecap="round"/>
              </svg>
            {% endif %}
          </h2>
        {% endif %}
      </div>
    </div>

  </div>
</footer>

<script>
  (function() {
    function initFooterAccordion() {
      const isMobile = () => window.innerWidth < 768;
      const columns = document.querySelectorAll('.fragranco-footer-col');

      columns.forEach(col => {
        const btn = col.querySelector('.fragranco-col-heading');
        if (!btn) return;

        btn.addEventListener('click', () => {
          if (!isMobile()) return;
          
          const isActive = col.classList.contains('active');
          
          // Collapse all other columns
          columns.forEach(otherCol => {
            if (otherCol !== col) {
              otherCol.classList.remove('active');
              const otherBtn = otherCol.querySelector('.fragranco-col-heading');
              if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
            }
          });

          // Toggle clicked column
          if (isActive) {
            col.classList.remove('active');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            col.classList.add('active');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });

      // Handle Currency Dropdown Toggle
      const currencyBtn = document.querySelector('.fragranco-currency-btn');
      const currencyMenu = document.querySelector('.fragranco-localization-menu');

      if (currencyBtn && currencyMenu) {
        currencyBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isExpanded = currencyBtn.getAttribute('aria-expanded') === 'true';
          currencyBtn.setAttribute('aria-expanded', !isExpanded);
          currencyMenu.classList.toggle('show');
        });

        document.addEventListener('click', (e) => {
          if (!currencyBtn.contains(e.target) && !currencyMenu.contains(e.target)) {
            currencyBtn.setAttribute('aria-expanded', 'false');
            currencyMenu.classList.remove('show');
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterAccordion);
    } else {
      initFooterAccordion();
    }
  })();
</script>

