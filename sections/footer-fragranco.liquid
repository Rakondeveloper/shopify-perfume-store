{% style %}
  .fragranco-footer {
    background-color: {{ section.settings.bg_color | default: "#000000" }};
    color: {{ section.settings.text_color | default: "#F5F5F5" }};
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    font-family: var(--font-body--family), -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .fragranco-footer__inner {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
  }

  /* Upper Navigation Grid */
  .fragranco-footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px 60px;
    margin-bottom: 90px;
  }

  .fragranco-footer-col {
    display: flex;
    flex-direction: column;
  }

  /* Accordion Header (Desktop: static, Mobile: interactive) */
  .fragranco-col-heading {
    font-family: var(--font-heading--family), sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: {{ section.settings.heading_color | default: "#F5F5F5" }};
    margin: 0 0 24px 0;
    padding: 0;
    background: none;
    border: none;
    text-align: left;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    cursor: default;
  }

  .fragranco-col-heading-chevron {
    display: none;
    transition: transform 0.3s ease;
  }

  /* Link Lists */
  .fragranco-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fragranco-menu__link {
    color: {{ section.settings.link_color | default: "#A3A3A3" }};
    font-size: 14px;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
    display: inline-block;
  }

  .fragranco-menu__link:hover,
  .fragranco-menu__link:focus-visible {
    color: {{ section.settings.link_hover_color | default: "#FFFFFF" }};
    transform: translateX(3px);
  }

  /* Column 4 Controls (Currency, Payments, Socials) */
  .fragranco-controls-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Localization / Currency Form */
  .fragranco-localization-form {
    position: relative;
    display: inline-block;
  }

  .fragranco-currency-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    color: #F5F5F5;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .fragranco-currency-btn:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background-color: rgba(255, 255, 255, 0.05);
  }

  .fragranco-flag-icon {
    width: 20px;
    height: 14px;
    border-radius: 2px;
    object-fit: cover;
    display: block;
  }

  .fragranco-currency-label {
    letter-spacing: 0.05em;
  }

  /* Native localization dropdown menu */
  .fragranco-localization-menu {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin-bottom: 8px;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 8px 0;
    min-width: 160px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    z-index: 10;
    display: none;
    max-height: 240px;
    overflow-y: auto;
  }

  .fragranco-localization-menu.show {
    display: block;
  }

  .fragranco-localization-item {
    width: 100%;
    padding: 8px 16px;
    background: none;
    border: none;
    color: #A3A3A3;
    font-size: 13px;
    text-align: left;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .fragranco-localization-item:hover,
  .fragranco-localization-item.active {
    background: rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
  }

  /* Payment Method Badges */
  .fragranco-payments-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .fragranco-payment-badge {
    height: 24px;
    width: 38px;
    border-radius: 4px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 2px 4px;
  }

  .fragranco-payment-badge svg {
    max-width: 100%;
    max-height: 100%;
  }

  /* Social Icons */
  .fragranco-socials-row {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .fragranco-social-link {
    color: {{ section.settings.link_color | default: "#F5F5F5" }};
    transition: color 0.2s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .fragranco-social-link:hover {
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  .fragranco-social-link svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  /* Oversized Brand Wordmark */
  .fragranco-wordmark-container {
    width: 100%;
    margin-top: 40px;
    position: relative;
    user-select: none;
  }

  .fragranco-wordmark-flex {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    width: 100%;
    white-space: nowrap;
  }

  .fragranco-wordmark-title {
    font-family: var(--font-heading--family), 'Inter', 'Montserrat', -apple-system, sans-serif;
    font-size: clamp(3.5rem, 14vw, 15.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.85;
    color: {{ section.settings.brand_text_color | default: "#F5F5F5" }};
    margin: 0;
    padding: 0;
    text-transform: none;
    display: inline-flex;
    align-items: flex-start;
  }

  .fragranco-wordmark-logo-img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Starburst / Sunburst Icon */
  .fragranco-starburst-icon {
    display: inline-block;
    width: clamp(2rem, 8.5vw, 9.5rem);
    height: clamp(2rem, 8.5vw, 9.5rem);
    margin-left: -0.08em;
    margin-top: -0.05em;
    color: {{ section.settings.brand_text_color | default: "#F5F5F5" }};
    vertical-align: top;
    flex-shrink: 0;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1023px) {
    .fragranco-footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 50px 40px;
      margin-bottom: 60px;
    }
  }

  @media (max-width: 767px) {
    .fragranco-footer {
      padding-top: 50px;
      padding-bottom: 40px;
    }

    .fragranco-footer__inner {
      padding: 0 24px;
    }

    .fragranco-footer__grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 50px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .fragranco-footer-col {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .fragranco-col-heading {
      padding: 20px 0;
      margin: 0;
      cursor: pointer;
      font-size: 14px;
    }

    .fragranco-col-heading-chevron {
      display: block;
    }

    .fragranco-footer-col.active .fragranco-col-heading-chevron {
      transform: rotate(180deg);
    }

    .fragranco-accordion-body {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .fragranco-footer-col.active .fragranco-accordion-body {
      max-height: 350px;
    }

    .fragranco-menu {
      padding-bottom: 20px;
      gap: 12px;
    }

    .fragranco-controls-col {
      padding-top: 30px;
      gap: 24px;
      align-items: flex-start;
    }

    .fragranco-wordmark-container {
      margin-top: 30px;
    }
  }

  /* Keyboard Accessibility */
  .fragranco-col-heading:focus-visible,
  .fragranco-currency-btn:focus-visible,
  .fragranco-social-link:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 4px;
  }
{% endstyle %}

<footer class="fragranco-footer" role="contentinfo">
  <div class="fragranco-footer__inner">
    
    <!-- 4-Column Navigation & Controls Grid -->
    <div class="fragranco-footer__grid">
      
      <!-- Column 1: SHOP -->
      <div class="fragranco-footer-col">
        <button type="button" class="fragranco-col-heading" aria-expanded="false" aria-controls="fragranco-menu-shop">
          <span>{{ section.settings.title_shop | default: "SHOP" }}</span>
          <svg class="fragranco-col-heading-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div id="fragranco-menu-shop" class="fragranco-accordion-body">
          <ul class="fragranco-menu">
            {% if section.settings.menu_shop != blank %}
              {% for link in section.settings.menu_shop.links %}
                <li><a href="{{ link.url }}" class="fragranco-menu__link">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/collections/all" class="fragranco-menu__link">All Perfumes</a></li>
              <li><a href="/collections/all" class="fragranco-menu__link">Best Sellers</a></li>
              <li><a href="/collections/all" class="fragranco-menu__link">New Arrivals</a></li>
              <li><a href="/collections/all" class="fragranco-menu__link">Gift Sets</a></li>
              <li><a href="/collections/all" class="fragranco-menu__link">Offers & Discounts</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Column 2: CUSTOMER CARE -->
      <div class="fragranco-footer-col">
        <button type="button" class="fragranco-col-heading" aria-expanded="false" aria-controls="fragranco-menu-care">
          <span>{{ section.settings.title_customer_care | default: "CUSTOMER CARE" }}</span>
          <svg class="fragranco-col-heading-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div id="fragranco-menu-care" class="fragranco-accordion-body">
          <ul class="fragranco-menu">
            {% if section.settings.menu_customer_care != blank %}
              {% for link in section.settings.menu_customer_care.links %}
                <li><a href="{{ link.url }}" class="fragranco-menu__link">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/pages/contact" class="fragranco-menu__link">Contact Us</a></li>
              <li><a href="/pages/faqs" class="fragranco-menu__link">FAQs</a></li>
              <li><a href="/pages/shipping" class="fragranco-menu__link">Shipping & Delivery</a></li>
              <li><a href="/pages/returns" class="fragranco-menu__link">Returns & Refunds</a></li>
              <li><a href="/pages/order-tracking" class="fragranco-menu__link">Order Tracking</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Column 3: INFORMATION -->
      <div class="fragranco-footer-col">
        <button type="button" class="fragranco-col-heading" aria-expanded="false" aria-controls="fragranco-menu-info">
          <span>{{ section.settings.title_information | default: "INFORMATION" }}</span>
          <svg class="fragranco-col-heading-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div id="fragranco-menu-info" class="fragranco-accordion-body">
          <ul class="fragranco-menu">
            {% if section.settings.menu_information != blank %}
              {% for link in section.settings.menu_information.links %}
                <li><a href="{{ link.url }}" class="fragranco-menu__link">{{ link.title }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="/policies/privacy-policy" class="fragranco-menu__link">Privacy Policy</a></li>
              <li><a href="/policies/terms-of-service" class="fragranco-menu__link">Terms & Conditions</a></li>
              <li><a href="/policies/refund-policy" class="fragranco-menu__link">Refund Policy</a></li>
              <li><a href="/pages/disclaimer" class="fragranco-menu__link">Disclaimer</a></li>
            {% endif %}
          </ul>
        </div>
      </div>

      <!-- Column 4: STORE CONTROLS (Currency, Payments, Socials) -->
      <div class="fragranco-controls-col">
        
        <!-- Country / Currency Selector -->
        {% if section.settings.show_country_selector %}
          <div class="fragranco-localization-form">
            {% form 'localization', id: 'FooterFragrancoLocalization' %}
              <button type="button" class="fragranco-currency-btn" aria-haspopup="true" aria-expanded="false" aria-label="Select Country and Currency">
                <!-- US Flag SVG Icon -->
                <svg class="fragranco-flag-icon" viewBox="0 0 640 480" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill="#bd3d44" d="M0 0h640v480H0z"/>
                  <path stroke="#fff" stroke-width="37" d="M0 55.5h640M0 130h640M0 203h640M0 277h640M0 350h640M0 425h640"/>
                  <path fill="#192f5d" d="M0 0h256v258H0z"/>
                  <circle cx="28" cy="26" r="6" fill="#fff"/><circle cx="78" cy="26" r="6" fill="#fff"/><circle cx="128" cy="26" r="6" fill="#fff"/><circle cx="178" cy="26" r="6" fill="#fff"/><circle cx="228" cy="26" r="6" fill="#fff"/>
                  <circle cx="53" cy="52" r="6" fill="#fff"/><circle cx="103" cy="52" r="6" fill="#fff"/><circle cx="153" cy="52" r="6" fill="#fff"/><circle cx="203" cy="52" r="6" fill="#fff"/>
                  <circle cx="28" cy="78" r="6" fill="#fff"/><circle cx="78" cy="78" r="6" fill="#fff"/><circle cx="128" cy="78" r="6" fill="#fff"/><circle cx="178" cy="78" r="6" fill="#fff"/><circle cx="228" cy="78" r="6" fill="#fff"/>
                  <circle cx="53" cy="104" r="6" fill="#fff"/><circle cx="103" cy="104" r="6" fill="#fff"/><circle cx="153" cy="104" r="6" fill="#fff"/><circle cx="203" cy="104" r="6" fill="#fff"/>
                  <circle cx="28" cy="130" r="6" fill="#fff"/><circle cx="78" cy="130" r="6" fill="#fff"/><circle cx="128" cy="130" r="6" fill="#fff"/><circle cx="178" cy="130" r="6" fill="#fff"/><circle cx="228" cy="130" r="6" fill="#fff"/>
                  <circle cx="53" cy="156" r="6" fill="#fff"/><circle cx="103" cy="156" r="6" fill="#fff"/><circle cx="153" cy="156" r="6" fill="#fff"/><circle cx="203" cy="156" r="6" fill="#fff"/>
                  <circle cx="28" cy="182" r="6" fill="#fff"/><circle cx="78" cy="182" r="6" fill="#fff"/><circle cx="128" cy="182" r="6" fill="#fff"/><circle cx="178" cy="182" r="6" fill="#fff"/><circle cx="228" cy="182" r="6" fill="#fff"/>
                  <circle cx="53" cy="208" r="6" fill="#fff"/><circle cx="103" cy="208" r="6" fill="#fff"/><circle cx="153" cy="208" r="6" fill="#fff"/><circle cx="203" cy="208" r="6" fill="#fff"/>
                  <circle cx="28" cy="234" r="6" fill="#fff"/><circle cx="78" cy="234" r="6" fill="#fff"/><circle cx="128" cy="234" r="6" fill="#fff"/><circle cx="178" cy="234" r="6" fill="#fff"/><circle cx="228" cy="234" r="6" fill="#fff"/>
                </svg>
                <span class="fragranco-currency-label">{{ localization.country.currency.iso_code | default: "USD" }}/{{ localization.country.iso_code | default: "US" }}</span>
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <ul class="fragranco-localization-menu" role="list">
                {% for country in localization.available_countries %}
                  <li>
                    <button type="submit" name="country_code" value="{{ country.iso_code }}" class="fragranco-localization-item{% if country.iso_code == localization.country.iso_code %} active{% endif %}">
                      {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                    </button>
                  </li>
                {% else %}
                  <li>
                    <button type="button" class="fragranco-localization-item active">United States (USD $)</button>
                  </li>
                {% endfor %}
              </ul>
            {% endform %}
          </div>
        {% endif %}

        <!-- Payment Method Icons -->
        {% if section.settings.show_payment_icons %}
          <div class="fragranco-payments-row" aria-label="Supported Payment Methods">
            {% if shop.enabled_payment_types != empty %}
              {% for type in shop.enabled_payment_types %}
                <div class="fragranco-payment-badge">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</div>
              {% endfor %}
            {% else %}
              <!-- Fallback Crisp SVG Payment Badges -->
              <!-- Amex -->
              <div class="fragranco-payment-badge" title="American Express">
                <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="3" fill="#006FCF"/><path d="M6 14.5l1.2-3h2l.7 3h-1.2l-.2-.8H7.3l-.2.8H6zm1.5-1.6h.8l-.4-1.2-.4 1.2zm4.5 1.6V9.5h2.2l1 2.8 1-2.8H18.5v5h-1.2v-3.5l-1 2.8h-.8l-1-2.8v3.5h-1.2zm8.5 0V9.5h3.5v1h-2.3v1h2.2v1h-2.2v1h2.3v1h-3.5zm4.8 0l1.2-2.5-1.2-2.5h1.4l.6 1.4.6-1.4h1.4l-1.2 2.5 1.2 2.5h-1.4l-.6-1.4-.6 1.4h-1.4z" fill="#FFF"/></svg>
              </div>
              <!-- Visa -->
              <div class="fragranco-payment-badge" title="Visa">
                <svg viewBox="0 0 38 24" xmlns="http://www.w3.org/2000/svg"><rect width="38" height="24" rx="3" fill="#1A1F71"/><path d="M15.2 16.5l1.6-9.8h2.6l-1.6 9.8h-2.6zm8.8-9.6c-.5-.2-1.3-.4-2.3-.4-2.5 0-4.3 1.3-4.3 3.2 0 1.4 1.3 2.2 2.2 2.7.9.5 1.2.8 1.2 1.2 0 .6-.8.9-1.5.9-1 0-1.5-.1-2.3-.5l-.3-.2-.4 2.4c.7.3 1.9.6 3.2.6 3 0 4.9-1.5 4.9-3.7 0-1.2-.7-2.2-2.3-2.9-.9-.5-1.5-.8-1.5-1.2 0-.4.5-.8 1.5-.8.8 0 1.5.2 2 .4l.2.1.4-2.3zm6.6-.2h-2c-.6 0-1.1.2-1.3.8l-3.7 8.9h2.7l.5-1.5h3.3l.3 1.5h2.4l-2.2-9.7zm-2.8 6.2l1.1-3.1.6 3.1h-1.7zM12.5 6.7L9.9 13.3l-.3-1.4c-.5-1.7-2.1-3.6-3.9-4.5l2.5 9.1h2.7l4.1-9.8h-2.5z" fill="#FFF"/><path d="M7.7 6.7H3.6l-.1.3c3.1.8 5.2 2.7 6.1 5L8.7 7.6c-.3-.7-.9-.9-1-0.9z" fill="#F7B600"/></svg>
              </div>
              <!-- Mastercard -->
              <div class="fragranco-payment-badge" title="Mastercard">
