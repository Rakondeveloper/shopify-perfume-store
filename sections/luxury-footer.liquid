{% style %}
  .lux-footer {
    background-color: var(--color-bg-dark);
    color: var(--color-white);
    padding: 80px 0 40px 0;
    font-family: var(--font-luxury-body);
    font-size: 13px;
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  
  .lux-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(auto-fit, minmax(180px, 1fr));
    gap: 40px;
    margin-bottom: 60px;
  }
  
  .lux-footer-col {
    display: flex;
    flex-direction: column;
  }
  
  .lux-footer-col__title {
    font-family: var(--font-luxury-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 24px;
    color: var(--color-accent);
  }
  
  .lux-footer-col__logo {
    font-family: var(--font-luxury-heading);
    font-size: 26px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-white);
    margin-bottom: 20px;
    text-decoration: none;
    display: block;
  }
  
  .lux-footer-col__text {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255,255,255,0.65);
    margin-bottom: 24px;
  }
  
  /* Link Lists */
  .lux-footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .lux-footer-menu__link {
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    transition: var(--transition-smooth);
    display: inline-block;
  }
  
  .lux-footer-menu__link:hover {
    color: var(--color-accent);
    transform: translateX(4px);
  }
  
  /* Social Icons */
  .lux-footer-socials {
    display: flex;
    gap: 16px;
  }
  
  .lux-footer-social__link {
    color: rgba(255,255,255,0.65);
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .lux-footer-social__link:hover {
    color: var(--color-accent);
  }
  
  .lux-footer-social__link svg {
    width: 20px;
    height: 20px;
  }
  
  /* Newsletter Form inside footer */
  .lux-footer-newsletter__form {
    margin-top: 10px;
  }
  
  .lux-footer-newsletter__group {
    display: flex;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding-bottom: 6px;
    transition: var(--transition-smooth);
  }
  
  .lux-footer-newsletter__group:focus-within {
    border-bottom-color: var(--color-accent);
  }
  
  .lux-footer-newsletter__input {
    background: transparent;
    border: none;
    flex: 1;
    color: var(--color-white);
    padding: 8px 0;
    outline: none;
    font-family: var(--font-luxury-body);
    font-size: 13px;
  }
  
  .lux-footer-newsletter__input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }
  
  .lux-footer-newsletter__submit {
    background: transparent;
    border: none;
    color: var(--color-white);
    cursor: pointer;
    padding: 8px;
    transition: var(--transition-smooth);
    display: flex;
    align-items: center;
  }
  
  .lux-footer-newsletter__submit:hover {
    color: var(--color-accent);
  }
  
  .lux-footer-newsletter__submit svg {
    width: 16px;
    height: 16px;
  }
  
  /* Bottom Info Bar */
  .lux-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
    letter-spacing: 0.05em;
  }
  
  .lux-footer-bottom__payments {
    display: flex;
    gap: 8px;
  }
  
  .lux-footer-bottom__payments svg {
    width: 36px;
    height: 22px;
  }
  
  /* Massive Footer Anchor Text Logo */
  .lux-footer__giant-logo {
    text-align: center;
    font-family: var(--font-luxury-heading);
    font-size: calc(3.5rem + 11vw);
    font-weight: 700;
    color: rgba(255,255,255,0.025);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 0.95;
    margin-top: 60px;
    pointer-events: none;
    user-select: none;
  }
  
  @media (max-width: 991px) {
    .lux-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
  }
  
  @media (max-width: 576px) {
    .lux-footer__grid {
      grid-template-columns: 1fr;
    }
    
    .lux-footer {
      padding: 60px 0 30px 0;
    }
    
    .lux-footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
{% endstyle %}

<footer class="lux-footer">
  <div class="luxury-container">
    
    <!-- Top Block Grid -->
    <div class="lux-footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          
          {%- when 'brand_info' -%}
            <div class="lux-footer-col" {{ block.shopify_attributes }}>
              <a href="/" class="lux-footer-col__logo">
                {%- if block.settings.logo_svg != blank -% division -%}
                  {{ block.settings.logo_svg }}
                {%- else -%}
                  {{ block.settings.logo_text | default: shop.name }}
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <p class="lux-footer-col__text">{{ block.settings.text }}</p>
              {%- endif -%}
              
              <!-- Social links -->
              {%- if block.settings.show_socials -%}
                <div class="lux-footer-socials">
                  {%- if settings.social_facebook_link != blank -%}
                    <a href="{{ settings.social_facebook_link }}" class="lux-footer-social__link" aria-label="Facebook">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_instagram_link != blank -%}
                    <a href="{{ settings.social_instagram_link }}" class="lux-footer-social__link" aria-label="Instagram">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </a>
                  {%- endif -%}
                  {%- if settings.social_pinterest_link != blank -%}
                    <a href="{{ settings.social_pinterest_link }}" class="lux-footer-social__link" aria-label="Pinterest">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 22s1.5-5 2-7C9.3 13.7 9 12 9 10.5c0-2.8 1.6-4.9 3.8-4.9 1.1 0 2 .8 2 1.9 0 2.2-1.4 5.4-2.1 8.4-.2 1 1 1.8 2 1.8 3.6 0 6.4-3.8 6.4-9.3 0-4.8-3.5-8.2-8.5-8.2-5.7 0-9.1 4.3-9.1 8.8 0 1.7.7 3.6 1.5 4.6.2.2.2.4.1.7l-.6 2.4c-.1.3-.3.4-.6.3-2-.9-3.1-3.9-3.1-6.2C1.5 5 6.6 0 13.5 0 19 0 23.3 3.9 23.3 9.2c0 5.5-3.5 9.9-8.3 9.9-1.6 0-3.1-.8-3.6-1.8 0 0-.8 3.1-1 3.9-.4 1.4-1.4 3.1-2 4.1z"></path></svg>
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          
          {%- when 'link_list' -%}
            <div class="lux-footer-col" {{ block.shopify_attributes }}>
              <span class="lux-footer-col__title">{{ block.settings.title }}</span>
              <ul class="lux-footer-menu">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="lux-footer-menu__link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            
          {%- when 'newsletter' -%}
            <div class="lux-footer-col" {{ block.shopify_attributes }}>
              <span class="lux-footer-col__title">{{ block.settings.title }}</span>
              <p class="lux-footer-col__text">{{ block.settings.text }}</p>
              
              {%- form 'customer', class: 'lux-footer-newsletter__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="lux-footer-newsletter__group">
                  <input 
                    type="email" 
                    name="contact[email]" 
                    class="lux-footer-newsletter__input"
                    placeholder="{{ block.settings.placeholder }}"
                    required
                  >
                  <button type="submit" class="lux-footer-newsletter__submit" aria-label="Subscribe">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                  </button>
                </div>
              {%- endform -%}
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
    
    <!-- Middle info / payment symbols / copyright -->
    <div class="lux-footer-bottom">
      <div class="lux-footer-bottom__copy">
        {{ section.settings.copyright_text }} &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.
      </div>
      
      {%- if section.settings.show_payment_icons -%}
        <div class="lux-footer-bottom__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    
    <!-- Giant Logo Bottom Anchor -->
    {%- if section.settings.show_giant_logo -%}
      <div class="lux-footer__giant-logo">
        {{ section.settings.giant_logo_text | default: "Fragranço" }}
      </div>
    {%- endif -%}

  </div>
</footer>

{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Designed for luxury storefronts."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show Payment Icons",
      "default": true
    },
    {
      "type": "header",
      "content": "Giant Brand Watermark"
    },
    {
      "type": "checkbox",
      "id": "show_giant_logo",
      "label": "Show Giant Bottom Logo",
      "default": true
    },
    {
      "type": "text",
      "id": "giant_logo_text",
      "label": "Giant Bottom Logo Text",
      "default": "Fragranço"
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "brand_info",
      "name": "Brand Information",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "logo_text",
          "label": "Logo Text",
          "default": "Fragranço"
        },
        {
          "type": "html",
          "id": "logo_svg",
          "label": "Custom Logo SVG HTML"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description text",
          "default": "Discover curated luxury fragrances designed to enhance elegance and self-expression."
        },
        {
          "type": "checkbox",
          "id": "show_socials",
          "label": "Show Social Connections",
          "default": true
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Quick Links Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu List",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Footer Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Newsletter"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description text",
          "default": "Sign up for 10% off your first purchase."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Input Placeholder",
          "default": "Enter your email..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Footer",
      "blocks": [
        {
          "type": "brand_info"
        },
        {
          "type": "link_list",
          "settings": {
            "title": "Shop"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "title": "Support"
          }
        },
        {
          "type": "newsletter"
        }
      ]
    }
  ]
}
{% endschema %}
