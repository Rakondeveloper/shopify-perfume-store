{%- if section.settings.enable_announcement -%}
  {% style %}
    .announcement-bar-wrapper {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: 40px;
      padding-right: 40px;
      font-size: {{ section.settings.font_size }}px;
      font-weight: {{ section.settings.font_weight }};
      letter-spacing: {{ section.settings.letter_spacing }};
      position: relative;
      z-index: 101;
      font-family: var(--font-{{ section.settings.font_family_base }}--family), sans-serif;
      font-style: var(--font-{{ section.settings.font_family_base }}--style), normal;
      box-sizing: border-box;
      min-height: 42px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .announcement-bar-wrapper * {
      box-sizing: border-box;
    }

    .announcement-left {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      z-index: 2;
    }

    .announcement-localization-form {
      display: flex;
      gap: 32px; /* Spacing between dropdown selectors ~30-35px */
      align-items: center;
    }

    .announcement-select-wrapper {
      position: relative;
      display: inline-flex;
      align-items: center;
    }

    .announcement-select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background: transparent;
      border: none;
      color: inherit;
      font-family: inherit;
      font-size: inherit;
      font-weight: 500; /* dropdown text weight medium */
      padding-right: 14px;
      cursor: pointer;
      outline: none;
      line-height: 1;
      text-transform: uppercase;
      letter-spacing: inherit;
      width: auto;
    }

    .announcement-select option {
      background-color: #111111;
      color: #ffffff;
    }

    .announcement-select-arrow {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      font-size: 7px;
      pointer-events: none;
      color: inherit;
      line-height: 1;
      opacity: 0.8;
    }

    .announcement-center {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      z-index: 1;
      font-weight: 700; /* announcement text weight bold */
    }

    .announcement-center a {
      color: inherit;
      text-decoration: none;
    }

    .announcement-right {
      display: flex;
      gap: 24px;
      align-items: center;
      justify-content: flex-end;
      z-index: 2;
    }

    .announcement-link {
      color: inherit;
      text-decoration: none;
      transition: opacity 0.2s ease;
      white-space: nowrap;
      font-weight: 500; /* links weight medium */
    }

    .announcement-link:hover {
      opacity: 0.8;
      text-decoration: underline;
    }

    /* Desktop (>=1200px) */
    @media (min-width: 1200px) {
      .announcement-center {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        pointer-events: auto;
      }
    }

    /* Tablet (768px–1199px) */
    @media (min-width: 768px) and (max-width: 1199px) {
      .announcement-bar-wrapper {
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 12px; /* 10-12px vertical spacing */
        padding: 14px 16px; /* padding 12-16px */
        min-height: 85px; /* height ~80-90px */
        font-size: 14px; /* tablet font-size */
      }

      .announcement-left,
      .announcement-center,
      .announcement-right {
        position: static;
        transform: none;
        justify-content: center;
        width: 100%;
        text-align: center;
      }

      .announcement-localization-form {
        justify-content: center;
      }
    }

    /* Mobile (<768px) */
    @media (max-width: 767px) {
      .announcement-bar-wrapper {
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 10px; /* 8-10px gap */
        padding: 12px 16px; /* 16px horizontal padding */
        min-height: auto;
        font-size: 13px; /* mobile font-size */
      }

      .announcement-left,
      .announcement-center,
      .announcement-right {
        position: static;
        transform: none;
        justify-content: center;
        width: 100%;
        text-align: center;
      }

      .announcement-localization-form {
        justify-content: center;
      }

      /* Stack links vertically */
      .announcement-right {
        flex-direction: column;
        gap: 8px;
      }

      .announcement-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px; /* touch-friendly 40px */
        width: 100%;
        white-space: normal;
      }
    }
  {% endstyle %}

  <div class="announcement-bar-wrapper">
    <!-- Left selectors (Shopify Localization Dropdowns) -->
    <div class="announcement-left">
      {%- form 'localization', id: 'AnnouncementBarLocalizationForm', class: 'announcement-localization-form' -%}
        {%- if section.settings.show_currency_selector -%}
          <div class="announcement-select-wrapper">
            <select class="announcement-select" name="country_code" onchange="this.form.submit()" aria-label="Currency selector">
              {%- if localization.available_countries.size > 1 -%}
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.currency.iso_code }}
                  </option>
                {%- endfor -%}
              {%- else -%}
                <option value="{{ localization.country.iso_code }}" selected>{{ localization.country.currency.iso_code }}</option>
                {%- assign mock_currencies = section.settings.currency_list | split: ',' -%}
                {%- for c in mock_currencies -%}
                  {%- assign c_clean = c | strip -%}
                  {%- if c_clean != localization.country.currency.iso_code -%}
                    <option value="{{ c_clean }}">{{ c_clean }}</option>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </select>
            <span class="announcement-select-arrow">▼</span>
          </div>
        {%- endif -%}

        {%- if section.settings.show_language_selector -%}
          <div class="announcement-select-wrapper">
            <select class="announcement-select" name="language_code" onchange="this.form.submit()" aria-label="Language selector">
              {%- if localization.available_languages.size > 1 -%}
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              {%- else -%}
                <option value="{{ localization.language.iso_code }}" selected>{{ localization.language.endonym_name | capitalize }}</option>
                {%- assign mock_languages = section.settings.language_list | split: ',' -%}
                {%- for l in mock_languages -%}
                  {%- assign l_clean = l | strip -%}
                  {%- if l_clean != localization.language.endonym_name -%}
                    <option value="{{ l_clean | downcase }}">{{ l_clean }}</option>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </select>
            <span class="announcement-select-arrow">▼</span>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <!-- Center text -->
    <div class="announcement-center">
      {%- if section.settings.left_emoji != blank -%}
        <span>{{ section.settings.left_emoji }}</span>
      {%- endif -%}

      {%- if section.settings.announcement_link != blank -%}
        <a href="{{ section.settings.announcement_link }}">
          {{ section.settings.announcement_text }}
        </a>
      {%- else -%}
        <span>{{ section.settings.announcement_text }}</span>
      {%- endif -%}

      {%- if section.settings.right_emoji != blank -%}
        <span>{{ section.settings.right_emoji }}</span>
      {%- endif -%}
    </div>

    <!-- Right links -->
    <div class="announcement-right">
      {%- if section.settings.show_help_link and section.settings.help_text != blank -%}
        <a href="{{ section.settings.help_link | default: '#' }}" class="announcement-link">
          {{ section.settings.help_text }}
        </a>
      {%- endif -%}

      {%- if section.settings.show_connect_link and section.settings.connect_text != blank -%}
        <a href="{{ section.settings.connect_link | default: '#' }}" class="announcement-link">
          {{ section.settings.connect_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Luxury Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Left: Selectors"
    },
    {
      "type": "checkbox",
      "id": "show_currency_selector",
      "label": "Show Currency Selector",
      "default": true
    },
    {
      "type": "text",
      "id": "currency_list",
      "label": "Currency List (comma-separated)",
      "default": "QAR,USD,EUR,GBP,AED"
    },
    {
      "type": "text",
      "id": "default_currency",
      "label": "Default Currency",
      "default": "QAR"
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "Show Language Selector",
      "default": true
    },
    {
      "type": "text",
      "id": "language_list",
      "label": "Language List (comma-separated)",
      "default": "English,Arabic,French"
    },
    {
      "type": "text",
      "id": "default_language",
      "label": "Default Language",
      "default": "English"
    },
    {
      "type": "header",
      "content": "Center: Announcement"
    },
    {
      "type": "text",
      "id": "left_emoji",
      "label": "Left Emoji/Icon",
      "default": "🔥"
    },
    {
      "type": "textarea",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Only 11 days left until OFFER"
    },
    {
      "type": "text",
      "id": "right_emoji",
      "label": "Right Emoji/Icon",
      "default": "🔥"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "header",
      "content": "Right: Utility Links"
    },
    {
      "type": "checkbox",
      "id": "show_help_link",
      "label": "Show Help Link",
      "default": true
    },
    {
      "type": "text",
      "id": "help_text",
      "label": "Help & Info Text",
      "default": "Help & Information"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help & Info Link"
    },
    {
      "type": "checkbox",
      "id": "show_connect_link",
      "label": "Show Connect Link",
      "default": true
    },
    {
      "type": "text",
      "id": "connect_text",
      "label": "Connect Text",
      "default": "Connect with us"
    },
    {
      "type": "url",
      "id": "connect_link",
      "label": "Connect Link"
    },
    {
      "type": "header",
      "content": "Styles & Typography"
    },
    {
      "type": "select",
      "id": "font_family_base",
      "label": "Font Family Source",
      "options": [
        { "value": "body", "label": "Body Font" },
        { "value": "subheading", "label": "Subheading Font" },
        { "value": "heading", "label": "Heading Font" },
        { "value": "accent", "label": "Accent Font" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font Weight Override",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 11
    },
    {
      "type": "text",
      "id": "letter_spacing",
      "label": "Letter Spacing (CSS style)",
      "default": "0.05em"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Luxury Announcement Bar"
    }
  ]
}
{% endschema %}