{% style %}
  .hero-section-wrapper-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .hero-container-{{ section.id }} {
    max-width: {{ section.settings.container_width }}px;
    width: 100%;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
    position: relative;
    background: {{ section.settings.bg_gradient }};
    box-sizing: border-box;
  }

  .hero-slider-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.banner_height }}px;
    display: flex;
    overflow: hidden;
  }

  .hero-container-{{ section.id }}[data-drag="true"] .hero-slider-{{ section.id }} {
    cursor: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  .hero-container-{{ section.id }}[data-drag="true"] .hero-slider-{{ section.id }}.is-dragging {
    cursor: grabbing !important;
  }

  .hero-slide-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transform: translateX(100%);
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1), opacity 500ms ease, visibility 700ms ease;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    z-index: 1;
    box-sizing: border-box;
    will-change: transform, opacity;
  }

  .hero-slide-{{ section.id }}.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0) !important;
    z-index: 2;
  }

  .hero-slide-{{ section.id }}.slide-out-left {
    opacity: 0;
    visibility: hidden;
    transform: translateX(-100%) !important;
    z-index: 1;
  }

  .hero-slide-{{ section.id }}.slide-out-right {
    opacity: 0;
    visibility: hidden;
    transform: translateX(100%) !important;
    z-index: 1;
  }

  .hero-slide-{{ section.id }}.slide-in-left {
    transform: translateX(-100%);
    opacity: 0;
  }

  .hero-slide-{{ section.id }}.slide-in-right {
    transform: translateX(100%);
    opacity: 0;
  }

  /* Motion Graphics: Staggered Entrance Animations */
  .hero-slide-{{ section.id }}__heading {
    margin: 0;
    white-space: pre-line;
    transform: translateY(35px);
    opacity: 0;
    transition: transform 800ms cubic-bezier(0.16, 1, 0.3, 1) 150ms, opacity 600ms ease 150ms;
  }

  .hero-slide-{{ section.id }}.active .hero-slide-{{ section.id }}__heading {
    transform: translateY(0);
    opacity: 1;
  }

  .hero-slide-{{ section.id }}__btn {
    transform: translateY(25px) scale(0.96);
    opacity: 0;
    transition: transform 800ms cubic-bezier(0.16, 1, 0.3, 1) 300ms, opacity 600ms ease 300ms,
                color var(--btn-transition-duration) ease, 
                background-color var(--btn-transition-duration) ease, 
                border-color var(--btn-transition-duration) ease;
  }

  .hero-slide-{{ section.id }}.active .hero-slide-{{ section.id }}__btn {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .hero-slide-{{ section.id }}__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    display: block;
    transform: scale(1.08);
    transition: transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-slide-{{ section.id }}.active .hero-slide-{{ section.id }}__image {
    transform: scale(1);
  }

  .hero-slide-{{ section.id }}__left {
    padding-left: 80px;
    /* padding-top: 80px; */
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 5;
    box-sizing: border-box;
  }

  .hero-slide-{{ section.id }}__heading {
    margin: 0;
    white-space: pre-line;
  }

  /* CTA Button base styles */
  .hero-slide-{{ section.id }}__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: none;
    box-sizing: border-box;
  }

  .hero-slide-{{ section.id }}__btn-icon {
    display: flex;
    align-items: center;
  }

  .hero-slide-{{ section.id }}__btn-icon svg {
    display: block;
  }

  .hero-slide-{{ section.id }}__right {
    height: 100%;
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    position: relative;
    z-index: 3;
    /* overflow: hidden; */
  }

  .hero-slide-{{ section.id }}__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-slide-{{ section.id }}__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    display: block;
  }

  /* Overlay config */
  .hero-overlay-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #000000;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 4;
    pointer-events: none;
  }

  /* Dots pagination style */
  .hero-pagination-{{ section.id }} {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10;
  }

  .hero-pagination-{{ section.id }}__dot {
    background-color: rgba(255, 255, 255, 0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .hero-pagination-{{ section.id }}__dot:not(.active) {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .hero-pagination-{{ section.id }}__dot.active {
    width: 32px;
    height: 8px;
    border-radius: 4px;
    background-color: #ffffff;
  }

  /* Tablet and Mobile responsiveness */
  @media (max-width: 991px) {
    .hero-container-{{ section.id }} {
      border-radius: 28px;
    }

    .hero-slider-{{ section.id }} {
      height: auto;
    }

    .hero-slide-{{ section.id }} {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      height: auto;
      position: relative;
      opacity: 0;
      visibility: hidden;
      display: none;
    }

    .hero-slide-{{ section.id }}.active {
      opacity: 1;
      visibility: visible;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-slide-{{ section.id }}__left {
      padding: 60px 24px 30px 24px !important;
      align-items: center !important;
      text-align: center !important;
      width: 100%;
    }

    .hero-slide-{{ section.id }}__heading {
      text-align: center !important;
      margin-top: 0 !important;
      margin-bottom: 24px !important;
      max-width: 100% !important;
    }

    .hero-slide-{{ section.id }}__btn {
      width: 90% !important;
      max-width: 440px !important;
      height: 64px !important;
      padding: 0 24px !important;
      gap: 12px !important;
    }

    .hero-slide-{{ section.id }}__right {
      width: 100%;
      height: 380px;
      justify-content: center;
      padding-bottom: 40px;
    }

    .hero-slide-{{ section.id }}__image {
      object-position: center center;
      position: absolute;
      bottom: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-slide-{{ section.id }}__right {
      height: 280px;
    }
  }
{% endstyle %}

{%- for block in section.blocks -%}
  {%- if block.type == 'slide' -%}
    {%- assign heading_font = block.settings.heading_font -%}
    {%- assign btn_font = block.settings.btn_font -%}

    <style>
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ btn_font | font_face: font_display: 'swap' }}
      #slide-{{ block.id }} {
        --heading-font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --heading-font-weight: {{ block.settings.heading_weight }};
        --heading-size-desktop: {{ block.settings.heading_size_desktop }}px;
        --heading-size-tablet: {{ block.settings.heading_size_tablet }}px;
        --heading-size-mobile: {{ block.settings.heading_size_mobile }}px;
        --heading-line-height: {{ block.settings.heading_line_height }};
        --heading-letter-spacing: {{ block.settings.heading_letter_spacing }}em;
        --heading-text-transform: {{ block.settings.heading_text_transform }};
        --heading-color: {{ block.settings.heading_color }};
        --heading-align: {{ block.settings.heading_align }};
        --heading-margin-top: {{ block.settings.heading_margin_top }}px;
        --heading-margin-bottom: {{ block.settings.heading_margin_bottom }}px;
        --heading-max-width: {{ block.settings.heading_max_width }}px;

        --btn-font-family: {{ btn_font.family }}, {{ btn_font.fallback_families }};
        --btn-font-weight: {{ block.settings.btn_weight }};
        --btn-size-desktop: {{ block.settings.btn_size_desktop }}px;
        --btn-size-tablet: {{ block.settings.btn_size_tablet }}px;
        --btn-size-mobile: {{ block.settings.btn_size_mobile }}px;
        --btn-letter-spacing: {{ block.settings.btn_letter_spacing }}em;
        --btn-text-transform: {{ block.settings.btn_text_transform }};

        --btn-text-color: {{ block.settings.btn_text_color }};
        --btn-bg-color: {{ block.settings.btn_bg_color }};
        --btn-hover-text-color: {{ block.settings.btn_hover_text_color }};
        --btn-hover-bg-color: {{ block.settings.btn_hover_bg_color }};
        --btn-border-color: {{ block.settings.btn_border_color }};
        --btn-hover-border-color: {{ block.settings.btn_hover_border_color }};

        --btn-border-radius: {{ block.settings.btn_border_radius }}px;
        --btn-border-width: {{ block.settings.btn_border_width }}px;
        --btn-height: {{ block.settings.btn_height }}px;
        --btn-padding-horizontal: {{ block.settings.btn_padding_horizontal }}px;
        --btn-padding-vertical: {{ block.settings.btn_padding_vertical }}px;

        --btn-icon-color: {{ block.settings.btn_icon_color }};
        --btn-icon-size: {{ block.settings.btn_icon_size }}px;
        --btn-icon-gap: {{ block.settings.btn_icon_gap }}px;

        --btn-transition-duration: {{ block.settings.btn_transition_duration }}ms;
      }

      #slide-{{ block.id }} .hero-slide-{{ section.id }}__heading {
        font-family: var(--heading-font-family), serif;
        font-weight: var(--heading-font-weight);
        font-size: var(--heading-size-desktop);
        line-height: var(--heading-line-height);
        letter-spacing: var(--heading-letter-spacing);
        text-transform: var(--heading-text-transform);
        color: var(--heading-color);
        max-width: var(--heading-max-width);
        margin-top: var(--heading-margin-top);
        margin-bottom: var(--heading-margin-bottom);
        text-align: var(--heading-align);
        {%- if block.settings.heading_align == 'center' -%}
          margin-left: auto;
          margin-right: auto;
        {%- elsif block.settings.heading_align == 'right' -%}
          margin-left: auto;
          margin-right: 0;
        {%- endif -%}

        {%- if block.settings.enable_text_shadow -%}
          text-shadow: 0 0 {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
        {%- else -%}
          text-shadow: none;
        {%- endif -%}
      }

      #slide-{{ block.id }} .hero-slide-{{ section.id }}__left {
        {%- if block.settings.heading_align == 'center' -%}
          align-items: center;
        {%- elsif block.settings.heading_align == 'right' -%}
          align-items: flex-end;
        {%- else -%}
          align-items: flex-start;
        {%- endif -%}
      }

      #slide-{{ block.id }} .hero-slide-{{ section.id }}__btn {
        font-family: var(--btn-font-family), sans-serif;
        font-weight: var(--btn-font-weight);
        font-size: var(--btn-size-desktop);
        letter-spacing: var(--btn-letter-spacing);
        text-transform: var(--btn-text-transform);
        color: var(--btn-text-color);
        background-color: var(--btn-bg-color);
        border: var(--btn-border-width) solid var(--btn-border-color);
        border-radius: var(--btn-border-radius);
        height: var(--btn-height);
        padding: var(--btn-padding-vertical) var(--btn-padding-horizontal);
        gap: var(--btn-icon-gap);
        transition: color var(--btn-transition-duration) ease, 
                    background-color var(--btn-transition-duration) ease, 
                    border-color var(--btn-transition-duration) ease,
                    transform var(--btn-transition-duration) ease,
                    box-shadow var(--btn-transition-duration) ease;
      }

      #slide-{{ block.id }} .hero-slide-{{ section.id }}__btn:hover {
        color: var(--btn-hover-text-color);
        background-color: var(--btn-hover-bg-color);
        border-color: var(--btn-hover-border-color);
        {%- if block.settings.btn_hover_scale -%}
          transform: scale(1.02);
        {%- else -%}
          transform: none;
        {%- endif -%}
        {%- if block.settings.btn_hover_shadow -%}
          box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        {%- else -%}
          box-shadow: none;
        {%- endif -%}
      }

      #slide-{{ block.id }} .hero-slide-{{ section.id }}__btn-icon {
        color: var(--btn-icon-color);
      }

      #slide-{{ block.id }} .hero-slide-{{ section.id }}__btn-icon svg {
        width: var(--btn-icon-size);
        height: var(--btn-icon-size);
      }

      /* Tablet Breakpoint overrides */
      @media (max-width: 991px) {
        #slide-{{ block.id }} .hero-slide-{{ section.id }}__heading {
          font-size: var(--heading-size-tablet) !important;
        }
        #slide-{{ block.id }} .hero-slide-{{ section.id }}__btn {
          font-size: var(--btn-size-tablet) !important;
        }
      }

      /* Mobile Breakpoint overrides */
      @media (max-width: 768px) {
        #slide-{{ block.id }} .hero-slide-{{ section.id }}__heading {
          font-size: var(--heading-size-mobile) !important;
        }
        #slide-{{ block.id }} .hero-slide-{{ section.id }}__btn {
          font-size: var(--btn-size-mobile) !important;
        }
      }
    </style>
  {%- endif -%}
{%- endfor -%}

<div 
  class="hero-section-wrapper-{{ section.id }}" 
  id="hero-section-{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.speed }}"
  data-loop="{{ section.settings.enable_loop }}"
  data-drag="{{ section.settings.enable_drag | default: true }}"
  data-animation="{{ section.settings.animation_effect | default: 'motion_slide' }}"
>
  <div class="hero-container-{{ section.id }}" data-drag="{{ section.settings.enable_drag | default: true }}">
    <div class="hero-slider-{{ section.id }}">
      
      <!-- Overlay block -->
      {%- if section.settings.overlay_opacity > 0 -%}
        <div class="hero-overlay-{{ section.id }}"></div>
      {%- endif -%}

      <!-- Slide list -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div class="hero-slide-{{ section.id }} {% if forloop.first %}active{% endif %}" id="slide-{{ block.id }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <!-- Left Info Panel -->
            <div class="hero-slide-{{ section.id }}__left">
              {%- if block.settings.heading != blank -%}
                <h2 class="hero-slide-{{ section.id }}__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}

              {%- if block.settings.btn_label != blank and block.settings.btn_url != blank -%}
                {%- assign show_icon = block.settings.enable_icon -%}
                {%- assign icon_pos = block.settings.icon_position -%}
                {%- capture button_icon_svg -%}
                  {%- case block.settings.button_icon -%}
                    {%- when 'shopping-bag' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 8V18C6 19.1046 6.89543 20 8 20H16C17.1046 20 18 19.1046 18 18V8H6Z"></path>
                        <path d="M9 8V6C9 4.34315 10.3431 3 12 3C13.6569 3 15 4.34315 15 6V8"></path>
                        <path d="M10 11H14"></path>
                        <path d="M12 11V15"></path>
                        <path d="M10 13L12 15L14 13"></path>
                      </svg>
                    {%- when 'arrow-right' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    {%- when 'arrow-up-right' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    {%- when 'shopping-cart' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                    {%- when 'heart' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                    {%- when 'gift' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 12 20 22 4 22 4 12"></polyline>
                        <rect x="2" y="7" width="20" height="5"></rect>
                        <line x1="12" y1="22" x2="12" y2="7"></line>
                        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                      </svg>
                    {%- when 'perfume' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="6" y="10" width="12" height="11" rx="2"></rect>
                        <path d="M10 6h4v4h-4z"></path>
                        <path d="M12 3v3"></path>
                        <circle cx="12" cy="3" r="1"></circle>
                        <path d="M15 4c1-1 2-1 3 0"></path>
                        <path d="M16 6c.5-.5 1-.5 1.5 0"></path>
                      </svg>
                    {%- when 'custom_svg' -%}
                      {%- if block.settings.custom_svg != blank -%}
                        {{ block.settings.custom_svg }}
                      {%- endif -%}
                  {%- endcase -%}
                {%- endcapture -%}
                
                <a href="{{ block.settings.btn_url }}" class="hero-slide-{{ section.id }}__btn">
                  {%- if show_icon and icon_pos == 'left' -%}
                    <span class="hero-slide-{{ section.id }}__btn-icon" aria-hidden="true">
                      {{ button_icon_svg }}
                    </span>
                  {%- endif -%}

                  <span>{{ block.settings.btn_label }}</span>

                  {%- if show_icon and icon_pos == 'right' -%}
                    <span class="hero-slide-{{ section.id }}__btn-icon" aria-hidden="true">
                      {{ button_icon_svg }}
                    </span>
                  {%- endif -%}
                </a>
              {%- endif -%}
            </div>

            <!-- Right Image Panel -->
            <div class="hero-slide-{{ section.id }}__right">
              {%- if block.settings.image_desktop != blank -%}
                <picture class="hero-slide-{{ section.id }}__picture">
                  {%- if block.settings.image_mobile != blank -%}
                    <source media="(max-width: 768px)" srcset="{{ block.settings.image_mobile | image_url: width: 768 }}">
                  {%- endif -%}
                  {%- assign image_class = 'hero-slide-' | append: section.id | append: '__image' -%}
                  {{ block.settings.image_desktop | image_url: width: 1920 | image_tag: class: image_class, alt: block.settings.heading | escape }}
                </picture>
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg hero-slide-' | append: section.id | append: '__image' }}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Pagination dots -->
      {%- if section.settings.enable_pagination and section.blocks.size > 1 -%}
        <div class="hero-pagination-{{ section.id }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'slide' -%}
              <button 
                type="button" 
                class="hero-pagination-{{ section.id }}__dot {% if forloop.first %}active{% endif %}" 
                aria-label="Go to slide {{ forloop.index }}"
                data-dot-index="{{ forloop.index0 }}"
              ></button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.querySelector('#hero-section-{{ section.id }}');
    if (!section) return;

    const sliderContainer = section.querySelector('.hero-slider-{{ section.id }}');
    const slides = Array.from(section.querySelectorAll('.hero-slide-{{ section.id }}'));
    const dots = Array.from(section.querySelectorAll('.hero-pagination-{{ section.id }}__dot'));
    let currentIndex = 0;
    let isTransitioning = false;
    let autoplayInterval = null;
    const autoplay = section.dataset.autoplay === 'true';
    const speed = parseInt(section.dataset.speed) || 5;
    const loop = section.dataset.loop === 'true';
    const enableDrag = section.dataset.drag === 'true';
    const parsedSpeed = speed * 1000;

    function showSlide(targetIndex, direction = null) {
      if (slides.length <= 1 || isTransitioning) return;

      let nextIndex = targetIndex;
      if (nextIndex < 0) {
        nextIndex = loop ? slides.length - 1 : 0;
      } else if (nextIndex >= slides.length) {
        nextIndex = loop ? 0 : slides.length - 1;
      }

      if (nextIndex === currentIndex && slides[currentIndex].classList.contains('active')) return;

      // Determine sliding direction
      if (!direction) {
        direction = nextIndex > currentIndex ? 'next' : 'prev';
        if (loop && currentIndex === slides.length - 1 && nextIndex === 0) direction = 'next';
        if (loop && currentIndex === 0 && nextIndex === slides.length - 1) direction = 'prev';
      }

      isTransitioning = true;
      const currentSlide = slides[currentIndex];
      const nextSlideEl = slides[nextIndex];

      // Prepare target slide initial position
      nextSlideEl.style.transition = 'none';
      if (direction === 'next') {
        nextSlideEl.classList.remove('slide-out-left', 'slide-out-right', 'slide-in-left');
        nextSlideEl.classList.add('slide-in-right');
      } else {
        nextSlideEl.classList.remove('slide-out-left', 'slide-out-right', 'slide-in-right');
        nextSlideEl.classList.add('slide-in-left');
      }

      // Force reflow
      void nextSlideEl.offsetWidth;

      // Restore transition
      nextSlideEl.style.transition = '';
      currentSlide.style.transition = '';

      // Perform motion graphics transition
      currentSlide.classList.remove('active');
      if (direction === 'next') {
        currentSlide.classList.add('slide-out-left');
      } else {
        currentSlide.classList.add('slide-out-right');
      }

      nextSlideEl.classList.remove('slide-in-left', 'slide-in-right');
      nextSlideEl.classList.add('active');

      // Update Pagination Dots
      dots.forEach((dot, i) => {
        if (i === nextIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });

      currentIndex = nextIndex;

      setTimeout(() => {
        slides.forEach((slide, idx) => {
          if (idx !== currentIndex) {
            slide.classList.remove('slide-out-left', 'slide-out-right', 'slide-in-left', 'slide-in-right');
          }
        });
        isTransitioning = false;
      }, 700);
    }

    function nextSlide() {
      showSlide(currentIndex + 1, 'next');
    }

    function prevSlide() {
      showSlide(currentIndex - 1, 'prev');
    }

    function startAutoplay() {
      if (autoplay && slides.length > 1) {
        stopAutoplay();
        autoplayInterval = setInterval(nextSlide, parsedSpeed);
      }
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stopAutoplay();
        const dir = i > currentIndex ? 'next' : 'prev';
        showSlide(i, dir);
        startAutoplay();
      });
    });

    // Real-time Touch Swipe & Mouse Drag Feature Implementation
    if (enableDrag && sliderContainer && slides.length > 1) {
      let isDragging = false;
      let startX = 0;
      let currentX = 0;
      let hasDragged = false;
      let activeSlide = null;

      function onPointerDown(e) {
        if (isTransitioning) return;
        isDragging = true;
        hasDragged = false;
        startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        currentX = startX;
        activeSlide = slides[currentIndex];
        if (activeSlide) activeSlide.style.transition = 'none';
        sliderContainer.classList.add('is-dragging');
        stopAutoplay();
      }

      function onPointerMove(e) {
        if (!isDragging || !activeSlide) return;
        currentX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        const diffX = currentX - startX;
        if (Math.abs(diffX) > 8) {
          hasDragged = true;
          // Live drag translation effect
          activeSlide.style.transform = `translateX(${diffX * 0.85}px)`;
        }
      }

      function onPointerUp(e) {
        if (!isDragging) return;
        isDragging = false;
        sliderContainer.classList.remove('is-dragging');

        if (activeSlide) {
          activeSlide.style.transition = '';
          activeSlide.style.transform = '';
        }

        const diffX = currentX - startX;
        const threshold = 40;

        if (diffX < -threshold) {
          nextSlide();
        } else if (diffX > threshold) {
          prevSlide();
        }

        startAutoplay();
      }

      // Mouse Drag events
      sliderContainer.addEventListener('mousedown', onPointerDown);
      window.addEventListener('mousemove', onPointerMove);
      window.addEventListener('mouseup', onPointerUp);

      // Touch Swipe events
      sliderContainer.addEventListener('touchstart', onPointerDown, { passive: true });
      sliderContainer.addEventListener('touchmove', onPointerMove, { passive: true });
      sliderContainer.addEventListener('touchend', onPointerUp);

      // Prevent link/button click when drag gesture is executed
      sliderContainer.addEventListener('click', (e) => {
        if (hasDragged) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
    }

    // Pause on hover
    section.addEventListener('mouseenter', stopAutoplay);
    section.addEventListener('mouseleave', startAutoplay);

    // Initial show and start
    startAutoplay();
  });
</script>

