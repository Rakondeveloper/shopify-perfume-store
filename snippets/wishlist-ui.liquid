{% endstyle %}

<div class="wishlist-container">
  <h1 class="wishlist-title">My Wishlist</h1>
  
  <div id="wishlist-empty-state" class="wishlist-empty" style="display: none;">
    <p class="wishlist-empty-msg">Your wishlist is currently empty.</p>
    <a href="/collections/all" class="luxury-btn" style="display: inline-block; background: #111111; color: #ffffff; padding: 12px 32px; border-radius: 99px; text-decoration: none;">Continue Shopping</a>
  </div>
  
  <div id="wishlist-grid" class="lux-products-grid">
    <!-- Loaded dynamically -->
  </div>
</div>

<script>
  (function() {
    function initWishlistUI() {
      const grid = document.getElementById('wishlist-grid');
      const emptyState = document.getElementById('wishlist-empty-state');
      if (!grid || !emptyState) return;

      const customerId = "{% if customer %}{{ customer.id }}{% endif %}";
      const wishlistKey = customerId ? 'lux-wishlist-' + customerId : 'lux-wishlist';
      
      function loadWishlist() {
        const wishlist = JSON.parse(localStorage.getItem(wishlistKey) || '[]');
        if (wishlist.length === 0) {
          grid.style.display = 'none';
          emptyState.style.display = 'block';
          return;
        }
        
        grid.style.display = 'grid';
        emptyState.style.display = 'none';
        grid.innerHTML = '';
        
        wishlist.forEach(item => {
          const handle = typeof item === 'string' ? item : item.handle;
          if (!handle) return;
          
          fetch(`/products/${handle}.js`)
            .then(res => res.json())
            .then(product => {
              const formattedPrice = `Rs. ${(product.price / 100).toFixed(2)}`;
              const isSoldOut = !product.available;
              
              const card = document.createElement('div');
              card.className = 'lux-prod-item';
              card.innerHTML = `
                <div class="lux-prod-card" style="background: #ececec; cursor: pointer; position: relative;">
                  <a href="${product.url}" class="lux-prod-card-link" aria-label="${product.title}" style="position: absolute; top:0; left:0; width:100%; height:100%; z-index:2;"></a>
                  <div class="lux-prod-img-container" style="padding:0; display:flex; align-items:center; justify-content:center;">
                    <img src="${product.featured_image}" class="lux-prod-img" loading="lazy" alt="${product.title}" style="max-width:100%; max-height:100%; object-fit:cover; display:block; aspect-ratio:0.85;">
                  </div>
                  
                  <button class="lux-prod-wishlist-btn active" data-product-id="${product.id}" data-product-handle="${product.handle}" aria-label="Remove from wishlist" style="z-index:3;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#ff8c42" stroke="currentColor" stroke-width="2" class="heart-icon">
                      <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"></path>
                    </svg>
                  </button>

                  <button class="lux-prod-cart-btn" data-variant-id="${product.variants[0].id}" aria-label="Add to Cart" style="z-index:3;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </button>

                  <div class="lux-prod-overlay">
                    <div class="lux-prod-meta">
                      <h3 class="lux-prod-title">${product.title}</h3>
                      <p class="lux-prod-subtitle">${product.type || 'Signature Scent'}</p>
                    </div>

                    <div class="lux-prod-price-pill">${formattedPrice}</div>

                    <button class="lux-prod-buy-btn" data-variant-id="${product.variants[0].id}" ${isSoldOut ? 'disabled' : ''}>
                      <span>${isSoldOut ? 'Sold Out' : 'Buy Now'}</span>
                      <span class="lux-buy-arrow-icon">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                          <line x1="7" y1="17" x2="17" y2="7"></line>
                          <polyline points="7 7 17 7 17 17"></polyline>
                        </svg>
                      </span>
                    </button>
                  </div>
                </div>
              `;
              
              grid.appendChild(card);
              bindCardEvents(card, product);
            })
            .catch(err => console.error(err));
        });
      }
      
      function bindCardEvents(card, product) {
        const wishlistBtn = card.querySelector('.lux-prod-wishlist-btn');
        wishlistBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          
          let currentList = JSON.parse(localStorage.getItem(wishlistKey) || '[]');
          currentList = currentList.filter(item => {
            const itemHandle = typeof item === 'string' ? item : item.handle;
            return itemHandle !== product.handle;
          });
          localStorage.setItem(wishlistKey, JSON.stringify(currentList));
          document.dispatchEvent(new CustomEvent('lux:wishlist:update', { bubbles: true }));
          
          card.remove();
          
          if (typeof showToast === 'function') {
            showToast('Removed from Wishlist', 'info');
          }
          
          const updatedList = JSON.parse(localStorage.getItem(wishlistKey) || '[]');
          if (updatedList.length === 0) {
            grid.style.display = 'none';
            emptyState.style.display = 'block';
          }
        });
        
        const cartBtn = card.querySelector('.lux-prod-cart-btn');
        if (cartBtn) {
          fetch('/cart.js')
            .then(res => res.json())
            .then(cart => {
              const variantIdsInCart = cart.items.map(item => item.variant_id.toString());
              const id = cartBtn.dataset.variantId;
              if (variantIdsInCart.includes(id)) {
                cartBtn.classList.add('in-cart');
                cartBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path><polyline points="8.5 13.5 11 16 15.5 10.5" stroke="#2e7d32" stroke-width="2.2"></polyline></svg>`;
              }
            });

          cartBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const variantId = cartBtn.dataset.variantId;
            if (!variantId) return;
            
            cartBtn.classList.add('animating');
            setTimeout(() => cartBtn.classList.remove('animating'), 600);

            const cardObj = cartBtn.closest('.lux-prod-card') || cartBtn.parentElement;
            if (cardObj) {
              const sparkle = document.createElement('div');
              sparkle.className = 'lux-cart-sparkle';
              cardObj.appendChild(sparkle);
              setTimeout(() => sparkle.remove(), 650);
            }

            cartBtn.style.opacity = '0.6';
            cartBtn.disabled = true;

            const isInCart = cartBtn.classList.contains('in-cart');

            if (isInCart) {
              const cartPromise = fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: variantId.toString(), quantity: 0 })
              })
              .then(res => res.json())
              .then(cart => {
                cartBtn.style.opacity = '';
                cartBtn.disabled = false;
                cartBtn.classList.remove('in-cart');
                cartBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
                
                if (typeof updateCartCount === 'function') {
                  updateCartCount();
                }
                if (typeof showToast === 'function') {
                  showToast('✓ Product removed from cart', 'info', {
                    image: product.featured_image,
                    title: product.title,
                    subtitle: 'Removed'
                  });
                }

                return { detail: { cart: cart } };
              })
              .catch(err => {
                console.error(err);
                cartBtn.style.opacity = '';
                cartBtn.disabled = false;
                throw err;
              });

              const event = new CustomEvent('shopify:cart:lines-update', { bubbles: true });
              event.action = 'remove';
              event.promise = cartPromise;
              document.dispatchEvent(event);

            } else {
              const cartPromise = fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
              })
              .then(res => res.json())
              .then(data => {
                cartBtn.style.opacity = '';
                cartBtn.disabled = false;
                cartBtn.classList.add('in-cart');
                cartBtn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path><polyline points="8.5 13.5 11 16 15.5 10.5" stroke="#2e7d32" stroke-width="2.2"></polyline></svg>`;
                
                if (typeof updateCartCount === 'function') {
                  updateCartCount();
                }
                if (typeof showToast === 'function') {
                  showToast('🎉 Product added to your cart!', 'success', {
                    image: product.featured_image,
                    title: product.title,
                    subtitle: 'Quantity: 1',
                    buttonText: 'View Cart',
                    buttonLink: '/cart'
                  });
                }

                return fetch('/cart.js').then(res => res.json()).then(cart => {
                  return { detail: { cart: cart } };
                });
              })
              .catch(err => {
                console.error(err);
                cartBtn.style.opacity = '';
                cartBtn.disabled = false;
                throw err;
              });

              const event = new CustomEvent('shopify:cart:lines-update', { bubbles: true });
              event.action = 'add';
              event.promise = cartPromise;
              document.dispatchEvent(event);
            }
          });
        }
        
        const buyBtn = card.querySelector('.lux-prod-buy-btn');
        if (buyBtn) {
          buyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const variantId = buyBtn.dataset.variantId;
            
            buyBtn.style.opacity = '0.6';
            
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
            })
            .then(() => {
              window.location.href = '/checkout';
            })
            .catch(err => {
              console.error(err);
              buyBtn.style.opacity = '';
            });
          });
        }
      }
      
      function showToast(message, type = 'success', data = {}) {
        let container = document.querySelector('.lux-toast-container');
        if (!container) {
          container = document.createElement('div');
          container.className = 'lux-toast-container';
          document.body.appendChild(container);
        }

        const toast = document.createElement('div');
        toast.className = `lux-toast lux-toast--${type}`;
        
        let html = '';
        if (data.image) {
          html += `<img src="${data.image}" class="lux-toast-img" alt="${data.title || ''}">`;
        }
        
        html += `<div class="lux-toast-content">`;
        html += `<p class="lux-toast-title">${message}</p>`;
        if (data.subtitle) {
          html += `<p class="lux-toast-msg">${data.subtitle}</p>`;
        }
        html += `</div>`;
        
        if (data.buttonText && data.buttonLink) {
          html += `<a href="${data.buttonLink}" class="lux-toast-btn">${data.buttonText}</a>`;
        }
        
        toast.innerHTML = html;
        container.appendChild(toast);
        
        setTimeout(() => toast.classList.add('show'), 50);

        setTimeout(() => {
          toast.classList.remove('show');
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      }
      
      function updateWishlistCartStates() {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            const variantIdsInCart = cart.items.map(item => item.variant_id.toString());
            document.querySelectorAll('.lux-prod-cart-btn').forEach(btn => {
              const id = btn.dataset.variantId;
              if (variantIdsInCart.includes(id)) {
                btn.classList.add('in-cart');
                btn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2e7d32" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path><polyline points="8.5 13.5 11 16 15.5 10.5" stroke="#2e7d32" stroke-width="2.2"></polyline></svg>`;
              } else {
                btn.classList.remove('in-cart');
                btn.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;
              }
            });
          })
          .catch(err => console.error(err));
      }

      function updateCartCount() {
        fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            document.querySelectorAll('.lux-cart-count').forEach(el => {
              el.textContent = cart.item_count;
            });
            updateWishlistCartStates();
          })
          .catch(err => console.error(err));
      }

      document.addEventListener('shopify:cart:lines-update', function() {
        setTimeout(updateWishlistCartStates, 100);
      });

      loadWishlist();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWishlistUI);
    } else {
      initWishlistUI();
    }
  })();
</script>
